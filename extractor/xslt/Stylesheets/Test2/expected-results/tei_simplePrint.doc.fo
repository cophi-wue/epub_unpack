  <inline>&lt;/castItem&gt;</inline>
 <inline>&lt;/castGroup&gt;</inline>
 <inline>&lt;castItem&gt;</inline>
  <inline>&lt;role&gt;</inline>Si Bero<inline>&lt;/role&gt;</inline>
  <inline>&lt;roleDesc&gt;</inline>Sister to Dr Bero<inline>&lt;/roleDesc&gt;</inline>
  <inline>&lt;actor&gt;</inline>Deolo Adedoyin<inline>&lt;/actor&gt;</inline>
 <inline>&lt;/castItem&gt;</inline>
 <inline>&lt;castGroup&gt;</inline>
  <inline>&lt;head rend="braced"&gt;</inline>Two old women<inline>&lt;/head&gt;</inline>
  <inline>&lt;castItem&gt;</inline>
   <inline>&lt;role&gt;</inline>Iya Agba<inline>&lt;/role&gt;</inline>
   <inline>&lt;actor&gt;</inline>Nguba Agolia<inline>&lt;/actor&gt;</inline>
  <inline>&lt;/castItem&gt;</inline>
  <inline>&lt;castItem&gt;</inline>
   <inline>&lt;role&gt;</inline>Iya Mate<inline>&lt;/role&gt;</inline>
   <inline>&lt;actor&gt;</inline>Bopo George<inline>&lt;/actor&gt;</inline>
  <inline>&lt;/castItem&gt;</inline>
 <inline>&lt;/castGroup&gt;</inline>
 <inline>&lt;castItem&gt;</inline>
