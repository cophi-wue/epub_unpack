                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <block>
                                 <inline font-weight="bold">core: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.bibl" text-decoration="underline">bibl</basic-link>
                                 </inline>
                              </block>
                              <block>
                                 <inline font-weight="bold">header: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.publicationStmt" text-decoration="underline">publicationStmt</basic-link>
                                 </inline>
                              </block>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">May contain</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <inline font-weight="bold">core: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.p" text-decoration="underline">p</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">header: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.licence" text-decoration="underline">licence</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">linking: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.ab" text-decoration="underline">ab</basic-link>
                              </inline>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">A consistent format should be adopted</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;availability status="restricted"&gt;</inline>
 <inline>&lt;p&gt;</inline>Available for academic research purposes only.<inline>&lt;/p&gt;</inline>
                           <inline>&lt;/availability&gt;</inline>
                           <inline>&lt;availability status="free"&gt;</inline>
 <inline>&lt;p&gt;</inline>In the public domain<inline>&lt;/p&gt;</inline>
                           <inline>&lt;/availability&gt;</inline>
                           <inline>&lt;availability status="restricted"&gt;</inline>
 <inline>&lt;p&gt;</inline>Available under licence from the publishers.<inline>&lt;/p&gt;</inline>
                           <inline>&lt;/availability&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;availability&gt;</inline>
 <inline>&lt;licence target="http://opensource.org/licenses/MIT"&gt;</inline>
  <inline>&lt;p&gt;</inline>The MIT License
     applies to this document.<inline>&lt;/p&gt;</inline>
  <inline>&lt;p&gt;</inline>Copyright (C) 2011 by The University of Victoria<inline>&lt;/p&gt;</inline>
  <inline>&lt;p&gt;</inline>Permission is hereby granted, free of charge, to any person obtaining a copy
