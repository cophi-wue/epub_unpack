                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element keywords
{
   att.global.attributes,
   attribute scheme { text }?,
   ( term+ | list )
}</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
