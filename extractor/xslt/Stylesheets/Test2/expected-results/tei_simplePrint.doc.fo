               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">The <inline font-style="italic">rend</inline> attribute may be used, as here, to indicate whether the grouping is indicated by a brace, whitespace, font change, etc.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">Note that in this example the role description ‘friends of Mathias’ is understood to apply to both roles equally.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;castGroup rend="braced"&gt;</inline>
 <inline>&lt;castItem&gt;</inline>
  <inline>&lt;role&gt;</inline>Walter<inline>&lt;/role&gt;</inline>
  <inline>&lt;actor&gt;</inline>Mr Frank Hall<inline>&lt;/actor&gt;</inline>
 <inline>&lt;/castItem&gt;</inline>
 <inline>&lt;castItem&gt;</inline>
  <inline>&lt;role&gt;</inline>Hans<inline>&lt;/role&gt;</inline>
  <inline>&lt;actor&gt;</inline>Mr F.W. Irish<inline>&lt;/actor&gt;</inline>
 <inline>&lt;/castItem&gt;</inline>
 <inline>&lt;roleDesc&gt;</inline>friends of Mathias<inline>&lt;/roleDesc&gt;</inline>
                           <inline>&lt;/castGroup&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence minOccurs="1" maxOccurs="1"&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.global"/&gt;
   &lt;classRef key="model.headLike"/&gt;
  &lt;/alternate&gt;
  &lt;sequence minOccurs="1"
   maxOccurs="unbounded"&gt;
   &lt;alternate minOccurs="1" maxOccurs="1"&gt;
    &lt;elementRef key="castItem"/&gt;
    &lt;elementRef key="castGroup"/&gt;
    &lt;elementRef key="roleDesc"/&gt;
   &lt;/alternate&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
  &lt;sequence minOccurs="0" maxOccurs="1"&gt;
   &lt;elementRef key="trailer"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schema Declaration</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element castGroup
{
   att.global.attributes,
   (
      ( model.global | model.headLike )*,
      ( ( castItem | castGroup | roleDesc ), model.global* )+,
      ( trailer, model.global* )?
   )
}</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Processing Model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;model predicate="child::*" behaviour="list"&gt;
&lt;desc&gt;Insert list. &lt;/desc&gt;
&lt;param name="content"
 value="castItem|castGroup"/&gt;
&lt;/model&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.castItem"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.21. &lt;castItem&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e15785">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;castItem&gt; </inline>(cast list item) contains a single entry within a cast list, describing either a single role or a list of non-speaking roles. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/DR.html#DRCAST)">7.1.4. Cast Lists</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>drama</block>
                  </table-cell>
               </table-row>
