               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Used by</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <basic-link internal-destination="TEI.titlePage" text-decoration="underline">titlePage</basic-link>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.argument" text-decoration="underline">argument</basic-link>
                           <basic-link internal-destination="TEI.byline" text-decoration="underline">byline</basic-link>
                           <basic-link internal-destination="TEI.docAuthor" text-decoration="underline">docAuthor</basic-link>
                           <basic-link internal-destination="TEI.docDate" text-decoration="underline">docDate</basic-link>
                           <basic-link internal-destination="TEI.docEdition" text-decoration="underline">docEdition</basic-link>
                           <basic-link internal-destination="TEI.docImprint" text-decoration="underline">docImprint</basic-link>
                           <basic-link internal-destination="TEI.docTitle" text-decoration="underline">docTitle</basic-link>
                           <basic-link internal-destination="TEI.epigraph" text-decoration="underline">epigraph</basic-link>
                           <basic-link internal-destination="TEI.graphic" text-decoration="underline">graphic</basic-link>
                           <basic-link internal-destination="TEI.imprimatur" text-decoration="underline">imprimatur</basic-link>
                           <basic-link internal-destination="TEI.titlePart" text-decoration="underline">titlePart</basic-link>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="d27e90695"
                text-align="left"
                font-family="Times"
                font-size="14pt"
                font-weight="bold"
                space-after="3pt"
                space-before.optimum="9pt"
                text-indent="0em">17.3. Attribute classes</block>
         <block keep-with-next.within-page="always"
                id="TEI.att.ascribed"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.1. att.ascribed</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e90699">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.ascribed</inline> provides attributes for elements representing speech or action that can be ascribed to a specific individual. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COHQQ)">3.3.3. Quotation</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/TS.html#TSBA)">8.3. Elements Unique to Spoken Texts</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.change" text-decoration="underline">change</basic-link>
                           <basic-link internal-destination="TEI.q" text-decoration="underline">q</basic-link>
                           <basic-link internal-destination="TEI.sp" text-decoration="underline">sp</basic-link>
                           <basic-link internal-destination="TEI.stage" text-decoration="underline">stage</basic-link>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e90751">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>who</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates the person, or group of people, to whom the element content is ascribed.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e90758">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link> separated by whitespace</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>In the following example from Hamlet, speeches (<basic-link internal-destination="TEI.sp" text-decoration="underline">&lt;sp&gt;</basic-link>) in the body of the play are linked to <basic-link internal-destination="TEI.castItem" text-decoration="underline">&lt;castItem&gt;</basic-link> elements in the <basic-link internal-destination="TEI.castList" text-decoration="underline">&lt;castList&gt;</basic-link> using the <inline font-style="italic">who</inline> attribute.<block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;castItem type="role"&gt;</inline>
 <inline>&lt;role xml:id="Barnardo"&gt;</inline>Bernardo<inline>&lt;/role&gt;</inline>
                                                         <inline>&lt;/castItem&gt;</inline>
                                                         <inline>&lt;castItem type="role"&gt;</inline>
 <inline>&lt;role xml:id="Francisco"&gt;</inline>Francisco<inline>&lt;/role&gt;</inline>
 <inline>&lt;roleDesc&gt;</inline>a soldier<inline>&lt;/roleDesc&gt;</inline>
                                                         <inline>&lt;/castItem&gt;</inline>
                                                         <inline>&lt;!-- ... --&gt;</inline>
                                                         <inline>&lt;sp who="#Barnardo"&gt;</inline>
 <inline>&lt;speaker&gt;</inline>Bernardo<inline>&lt;/speaker&gt;</inline>
 <inline>&lt;l n="1"&gt;</inline>Who's there?<inline>&lt;/l&gt;</inline>
                                                         <inline>&lt;/sp&gt;</inline>
                                                         <inline>&lt;sp who="#Francisco"&gt;</inline>
 <inline>&lt;speaker&gt;</inline>Francisco<inline>&lt;/speaker&gt;</inline>
 <inline>&lt;l n="2"&gt;</inline>Nay, answer me: stand, and unfold yourself.<inline>&lt;/l&gt;</inline>
                                                         <inline>&lt;/sp&gt;</inline>
                                                      </block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">For transcribed speech, this will typically identify a participant or participant group; in other contexts, it will point to any identified <basic-link internal-destination="TEI.person" text-decoration="underline">&lt;person&gt;</basic-link> element.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.breaking"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.2. att.breaking</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e90827">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.breaking</inline> provides an attribute to indicate whether or not the element concerned is considered to mark the end of an orthographic token in the same way as whitespace. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CORS5)">3.10.3. Milestone Elements</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.cb" text-decoration="underline">cb</basic-link>
                           <basic-link internal-destination="TEI.lb" text-decoration="underline">lb</basic-link>
                           <basic-link internal-destination="TEI.milestone" text-decoration="underline">milestone</basic-link>
                           <basic-link internal-destination="TEI.pb" text-decoration="underline">pb</basic-link>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e90876">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>break</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates whether or not the element bearing this attribute should be considered to mark the end of an orthographic token in the same way as whitespace.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e90883">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Recommended</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.enumerated"
                                                                  text-decoration="underline">teidata.enumerated</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Sample values include</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <list-block provisional-distance-between-starts="18pt"
                                                                  provisional-label-separation="6pt"
                                                                  text-indent="0em"
                                                                  margin-right="10pt"
                                                                  space-before="6pt"
                                                                  space-after="6pt">
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">yes</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the element bearing this attribute is considered to mark the end of any adjacent orthographic token irrespective of the presence of any adjacent whitespace</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">no</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the element bearing this attribute is considered not to mark the end of any adjacent orthographic token irrespective of the presence of any adjacent whitespace</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">maybe</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the encoding does not take any position on this issue.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                      </list-block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>In the following lines from the ‘Dream of the Rood’, linebreaks occur in the middle of the words <inline font-style="italic" font-weight="normal">lāðost</inline> and <inline font-style="italic" font-weight="normal">reord-berendum</inline>.<block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;ab&gt;</inline> ...eƿesa tome iu icƿæs ȝeƿorden ƿita heardoſt .
 leodum la<inline>&lt;lb break="no"/&gt;</inline> ðost ærþan ichim lifes
 ƿeȝ rihtne ȝerymde reord be<inline>&lt;lb break="no"/&gt;</inline>
 rendum hƿæt me þaȝeƿeorðode ƿuldres ealdor ofer...
<inline>&lt;/ab&gt;</inline>
                                                      </block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.cReferencing"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.3. att.cReferencing</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e90942">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.cReferencing</inline> provides an attribute which may be used to supply a <inline font-style="italic" font-weight="normal">canonical reference</inline> as a means of identifying the target of a pointer.</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.ref" text-decoration="underline">ref</basic-link>
                           <basic-link internal-destination="TEI.term" text-decoration="underline">term</basic-link>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e90982">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>cRef</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>(canonical reference) specifies the destination of the pointer by supplying a canonical reference expressed using the scheme defined in a <basic-link internal-destination="TEI.refsDecl" text-decoration="underline">&lt;refsDecl&gt;</basic-link> element in the TEI header<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e90996">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.text" text-decoration="underline">teidata.text</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">The value of <inline font-style="italic">cRef</inline> should be constructed so that when the algorithm for the resolution of canonical references (described in section <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/SA.html#SACR)">16.2.5. Canonical References</basic-link>) is applied to it the result is a valid URI reference to the intended target</block>
                                                      <block line-height="1"
                                                             text-indent="1em"
                                                             space-before.optimum="0pt"
                                                             space-before.maximum="12pt">The <basic-link internal-destination="TEI.refsDecl" text-decoration="underline">&lt;refsDecl&gt;</basic-link> to use may be indicated with the <inline font-style="italic">decls</inline> attribute.</block>
                                                      <block line-height="1"
                                                             text-indent="1em"
                                                             space-before.optimum="0pt"
                                                             space-before.maximum="12pt">Currently these Guidelines only provide for a single canonical reference to be encoded on any given <inline hyphenate="false" color="black" font-family="Courier">&lt;ptr&gt;</inline> element.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.canonical"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.4. att.canonical</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e91041">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.canonical</inline> provides attributes which can be used to associate a representation such as a name or title with canonical information about the object being named or referenced.</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.att.naming" text-decoration="underline">att.naming</basic-link>
                           <inline>[<basic-link internal-destination="TEI.att.personal" text-decoration="underline">att.personal</basic-link>
                              <inline>[<basic-link internal-destination="TEI.name" text-decoration="underline">name</basic-link>]</inline>
                              <basic-link internal-destination="TEI.author" text-decoration="underline">author</basic-link>
                              <basic-link internal-destination="TEI.editor" text-decoration="underline">editor</basic-link>
                              <basic-link internal-destination="TEI.pubPlace" text-decoration="underline">pubPlace</basic-link>
                              <basic-link internal-destination="TEI.rs" text-decoration="underline">rs</basic-link>]</inline>
                           <basic-link internal-destination="TEI.docAuthor" text-decoration="underline">docAuthor</basic-link>
                           <basic-link internal-destination="TEI.docTitle" text-decoration="underline">docTitle</basic-link>
                           <basic-link internal-destination="TEI.resp" text-decoration="underline">resp</basic-link>
                           <basic-link internal-destination="TEI.respStmt" text-decoration="underline">respStmt</basic-link>
                           <basic-link internal-destination="TEI.term" text-decoration="underline">term</basic-link>
                           <basic-link internal-destination="TEI.title" text-decoration="underline">title</basic-link>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e91125">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>ref</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>(reference) provides an explicit means of locating a full definition or identity for the entity being named by means of one or more URIs.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91136">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link> separated by whitespace</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>
                                                      <block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;name ref="http://viaf.org/viaf/109557338"
 type="person"&gt;</inline>Seamus Heaney<inline>&lt;/name&gt;</inline>
                                                      </block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">The value must point directly to one or more XML elements or other resources by means of one or more URIs, separated by whitespace. If more than one is supplied the implication is that the name identifies several distinct entities.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.citing"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.5. att.citing</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e91175">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.citing</inline> provides attributes for specifying the specific part of a bibliographic item being cited. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STECAT)">1.3.1. Attribute Classes</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.biblScope" text-decoration="underline">biblScope</basic-link>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e91218">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>unit</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>identifies the unit of information conveyed by the element, e.g. <inline>columns</inline>, <inline>pages</inline>, <inline>volume</inline>.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91234">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.enumerated"
                                                                  text-decoration="underline">teidata.enumerated</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Suggested values include:</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <list-block provisional-distance-between-starts="18pt"
                                                                  provisional-label-separation="6pt"
                                                                  text-indent="0em"
                                                                  margin-right="10pt"
                                                                  space-before="6pt"
                                                                  space-after="6pt">
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">volume</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the element contains a volume number.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">issue</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the element contains an issue number, or volume and issue numbers.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">page</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the element contains a page number or page range.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">line</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the element contains a line number or line range.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">chapter</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the element contains a chapter indication (number and/or title)</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">part</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the element identifies a part of a book or collection.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">column</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the element identifies a column.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                      </list-block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>from</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>specifies the starting point of the range of units indicated by the <inline font-style="italic">unit</inline> attribute.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91302">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.word" text-decoration="underline">teidata.word</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>to</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>specifies the end-point of the range of units indicated by the <inline font-style="italic">unit</inline> attribute.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91328">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.word" text-decoration="underline">teidata.word</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.coordinated"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.6. att.coordinated</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e91347">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.coordinated</inline> provides attributes which can be used to position their parent element within a two dimensional coordinate system.</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>transcr</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.surface" text-decoration="underline">surface</basic-link>
                           <basic-link internal-destination="TEI.zone" text-decoration="underline">zone</basic-link>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e91399">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>start</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates the element within a transcription of the text containing at least the start of the writing represented by this zone or surface.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91406">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>ulx</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>gives the x coordinate value for the upper left corner of a rectangular space.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91429">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.numeric" text-decoration="underline">teidata.numeric</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>uly</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>gives the y coordinate value for the upper left corner of a rectangular space.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91452">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.numeric" text-decoration="underline">teidata.numeric</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>lrx</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>gives the x coordinate value for the lower right corner of a rectangular space.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91475">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.numeric" text-decoration="underline">teidata.numeric</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>lry</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>gives the y coordinate value for the lower right corner of a rectangular space.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91498">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.numeric" text-decoration="underline">teidata.numeric</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>points</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>identifies a two dimensional area within the bounding box specified by the other attributes by means of a series of pairs of numbers, each of which gives the x,y coordinates of a point on a line enclosing the area.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91521">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>3–∞ occurrences of <basic-link internal-destination="TEI.teidata.point" text-decoration="underline">teidata.point</basic-link> separated by whitespace</block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.datable"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.7. att.datable</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e91547">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.datable</inline> provides attributes for normalization of elements that contain dates, times, or datable events. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONADA)">3.5.4. Dates and Times</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDDATE)">13.3.6. Dates and Times</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.change" text-decoration="underline">change</basic-link>
                           <basic-link internal-destination="TEI.creation" text-decoration="underline">creation</basic-link>
                           <basic-link internal-destination="TEI.date" text-decoration="underline">date</basic-link>
                           <basic-link internal-destination="TEI.idno" text-decoration="underline">idno</basic-link>
                           <basic-link internal-destination="TEI.licence" text-decoration="underline">licence</basic-link>
                           <basic-link internal-destination="TEI.name" text-decoration="underline">name</basic-link>
                           <basic-link internal-destination="TEI.resp" text-decoration="underline">resp</basic-link>
                           <basic-link internal-destination="TEI.time" text-decoration="underline">time</basic-link>
                           <basic-link internal-destination="TEI.title" text-decoration="underline">title</basic-link>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.datable.w3c" text-decoration="underline">att.datable.w3c</basic-link> (<inline>@when</inline>, <inline>@notBefore</inline>, <inline>@notAfter</inline>, <inline>@from</inline>, <inline>@to</inline>) <table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e91645">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>calendar</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates the system or calendar to which the date represented by the content of this element belongs.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91652">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Schematron</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block>
&lt;sch:rule context="tei:*[@calendar]"&gt;
&lt;sch:assert test="string-length(.) gt 0"&gt;@calendar indicates the system or calendar to which the date represented by the content of this element
 belongs, but this &lt;sch:name/&gt; element has no textual content.&lt;/sch:assert&gt;
&lt;/sch:rule&gt;</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>
                                                      <block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">He was born on <inline>&lt;date calendar="#gregorian"&gt;</inline>Feb. 22, 1732<inline>&lt;/date&gt;</inline> 
 (<inline>&lt;date calendar="#julian"
 when="1732-02-22"&gt;</inline> Feb. 11, 1731/32, O.S.<inline>&lt;/date&gt;</inline>).</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">Note that the <inline font-style="italic">calendar</inline> attribute (unlike <inline font-style="italic">datingMethod</inline> defined in <inline color="black" font-family="Helvetica">att.datable.custom</inline>) defines the calendar system of the date in the original material defined by the parent element, <inline font-style="italic">not</inline> the calendar to which the date is normalized.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>period</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>supplies a pointer to some location defining a named period of time within which the datable item is understood to have occurred.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91711">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">This ‘superclass’ provides attributes that can be used to provide normalized values of temporal information. By default, the attributes from the <inline color="black" font-family="Helvetica">att.datable.w3c</inline> class are provided. If the module for names &amp; dates is loaded, this class also provides attributes from the <inline color="black" font-family="Helvetica">att.datable.iso</inline> and <inline color="black" font-family="Helvetica">att.datable.custom</inline> classes. In general, the possible values of attributes restricted to the W3C datatypes form a subset of those values available via the ISO 8601 standard. However, the greater expressiveness of the ISO datatypes may not be needed, and there exists much greater software support for the W3C datatypes.</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.datable.w3c"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.8. att.datable.w3c</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e91749">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.datable.w3c</inline> provides attributes for normalization of elements that contain datable events conforming to the W3C <inline font-style="italic">XML Schema Part 2: Datatypes Second Edition</inline>. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONADA)">3.5.4. Dates and Times</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDDATE)">13.3.6. Dates and Times</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.att.datable" text-decoration="underline">att.datable</basic-link>
                           <inline>[<basic-link internal-destination="TEI.change" text-decoration="underline">change</basic-link>
                              <basic-link internal-destination="TEI.creation" text-decoration="underline">creation</basic-link>
                              <basic-link internal-destination="TEI.date" text-decoration="underline">date</basic-link>
                              <basic-link internal-destination="TEI.idno" text-decoration="underline">idno</basic-link>
                              <basic-link internal-destination="TEI.licence" text-decoration="underline">licence</basic-link>
                              <basic-link internal-destination="TEI.name" text-decoration="underline">name</basic-link>
                              <basic-link internal-destination="TEI.resp" text-decoration="underline">resp</basic-link>
                              <basic-link internal-destination="TEI.time" text-decoration="underline">time</basic-link>
                              <basic-link internal-destination="TEI.title" text-decoration="underline">title</basic-link>]</inline>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e91842">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>when</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>supplies the value of the date or time in a standard form, e.g. yyyy-mm-dd.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91849">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.temporal.w3c"
                                                                  text-decoration="underline">teidata.temporal.w3c</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>Examples of W3C date, time, and date &amp; time formats.<block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;p&gt;</inline>
 <inline>&lt;date when="1945-10-24"&gt;</inline>24 Oct 45<inline>&lt;/date&gt;</inline>
 <inline>&lt;date when="1996-09-24T07:25:00Z"&gt;</inline>September 24th, 1996 at 3:25 in the morning<inline>&lt;/date&gt;</inline>
 <inline>&lt;time when="1999-01-04T20:42:00-05:00"&gt;</inline>Jan 4 1999 at 8 pm<inline>&lt;/time&gt;</inline>
 <inline>&lt;time when="14:12:38"&gt;</inline>fourteen twelve and 38 seconds<inline>&lt;/time&gt;</inline>
 <inline>&lt;date when="1962-10"&gt;</inline>October of 1962<inline>&lt;/date&gt;</inline>
 <inline>&lt;date when="--06-12"&gt;</inline>June 12th<inline>&lt;/date&gt;</inline>
 <inline>&lt;date when="---01"&gt;</inline>the first of the month<inline>&lt;/date&gt;</inline>
 <inline>&lt;date when="--08"&gt;</inline>August<inline>&lt;/date&gt;</inline>
 <inline>&lt;date when="2006"&gt;</inline>MMVI<inline>&lt;/date&gt;</inline>
 <inline>&lt;date when="0056"&gt;</inline>AD 56<inline>&lt;/date&gt;</inline>
 <inline>&lt;date when="-0056"&gt;</inline>56 BC<inline>&lt;/date&gt;</inline>
                                                         <inline>&lt;/p&gt;</inline>
                                                      </block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>
                                                      <block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">This list begins in
 the year 1632, more precisely on Trinity Sunday, i.e. the Sunday after
 Pentecost, in that year the
<inline>&lt;date calendar="#julian"
 when="1632-06-06"&gt;</inline>27th of May (old style)<inline>&lt;/date&gt;</inline>.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>
                                                      <block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;opener&gt;</inline>
 <inline>&lt;dateline&gt;</inline>
  <inline>&lt;placeName&gt;</inline>Dorchester, Village,<inline>&lt;/placeName&gt;</inline>
  <inline>&lt;date when="1828-03-02"&gt;</inline>March 2d. 1828.<inline>&lt;/date&gt;</inline>
 <inline>&lt;/dateline&gt;</inline>
 <inline>&lt;salute&gt;</inline>To
   Mrs. Cornell,<inline>&lt;/salute&gt;</inline> Sunday <inline>&lt;time when="12:00:00"&gt;</inline>noon.<inline>&lt;/time&gt;</inline>
                                                         <inline>&lt;/opener&gt;</inline>
                                                      </block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>notBefore</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>specifies the earliest possible date for the event in standard form, e.g. yyyy-mm-dd.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91918">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.temporal.w3c"
                                                                  text-decoration="underline">teidata.temporal.w3c</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>notAfter</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>specifies the latest possible date for the event in standard form, e.g. yyyy-mm-dd.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91941">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.temporal.w3c"
                                                                  text-decoration="underline">teidata.temporal.w3c</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>from</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates the starting point of the period in standard form, e.g. yyyy-mm-dd.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91964">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.temporal.w3c"
                                                                  text-decoration="underline">teidata.temporal.w3c</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>to</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates the ending point of the period in standard form, e.g. yyyy-mm-dd.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e91987">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.temporal.w3c"
                                                                  text-decoration="underline">teidata.temporal.w3c</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;sch:rule context="tei:*[@when]"&gt;
&lt;sch:report test="@notBefore|@notAfter|@from|@to"
 role="nonfatal"&gt;The @when attribute cannot be used with any other att.datable.w3c attributes.&lt;/sch:report&gt;
&lt;/sch:rule&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;sch:rule context="tei:*[@from]"&gt;
&lt;sch:report test="@notBefore"
 role="nonfatal"&gt;The @from and @notBefore attributes cannot be used together.&lt;/sch:report&gt;
&lt;/sch:rule&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;sch:rule context="tei:*[@to]"&gt;
&lt;sch:report test="@notAfter"
 role="nonfatal"&gt;The @to and @notAfter attributes cannot be used together.&lt;/sch:report&gt;
&lt;/sch:rule&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;date from="1863-05-28" to="1863-06-01"&gt;</inline>28 May through 1 June 1863<inline>&lt;/date&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">The value of these attributes should be a normalized representation of the date, time, or combined date &amp; time intended, in any of the standard formats specified by <inline font-style="italic">XML Schema Part 2: Datatypes Second Edition</inline>, using the Gregorian calendar.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">The most commonly-encountered format for the date portion of a temporal attribute is <inline font-family="Courier">yyyy-mm-dd</inline>, but <inline font-family="Courier">yyyy</inline>, <inline font-family="Courier">--mm</inline>, <inline font-family="Courier">---dd</inline>, <inline font-family="Courier">yyyy-mm</inline>, or <inline font-family="Courier">--mm-dd</inline> may also be used. For the time part, the form <inline font-family="Courier">hh:mm:ss</inline> is used.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">Note that this format does not currently permit use of the value <inline>0000</inline> to represent the year 1 BCE; instead the value <inline>-0001</inline> should be used.</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.dimensions"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.9. att.dimensions</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e92071">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.dimensions</inline> provides attributes for describing the size of physical objects.</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.att.editLike" text-decoration="underline">att.editLike</basic-link>
                           <inline>[<basic-link internal-destination="TEI.att.transcriptional"
                                          text-decoration="underline">att.transcriptional</basic-link>
                              <inline>[<basic-link internal-destination="TEI.add" text-decoration="underline">add</basic-link>
                                 <basic-link internal-destination="TEI.del" text-decoration="underline">del</basic-link>
                                 <basic-link internal-destination="TEI.subst" text-decoration="underline">subst</basic-link>]</inline>
                              <basic-link internal-destination="TEI.corr" text-decoration="underline">corr</basic-link>
                              <basic-link internal-destination="TEI.date" text-decoration="underline">date</basic-link>
                              <basic-link internal-destination="TEI.expan" text-decoration="underline">expan</basic-link>
                              <basic-link internal-destination="TEI.gap" text-decoration="underline">gap</basic-link>
                              <basic-link internal-destination="TEI.name" text-decoration="underline">name</basic-link>
                              <basic-link internal-destination="TEI.person" text-decoration="underline">person</basic-link>
                              <basic-link internal-destination="TEI.place" text-decoration="underline">place</basic-link>
                              <basic-link internal-destination="TEI.reg" text-decoration="underline">reg</basic-link>
                              <basic-link internal-destination="TEI.supplied" text-decoration="underline">supplied</basic-link>
                              <basic-link internal-destination="TEI.time" text-decoration="underline">time</basic-link>
                              <basic-link internal-destination="TEI.unclear" text-decoration="underline">unclear</basic-link>]</inline>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e92177">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>unit</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>names the unit used for the measurement<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e92184">
                                          <table-column column-number="1" column-width="20%"/>
