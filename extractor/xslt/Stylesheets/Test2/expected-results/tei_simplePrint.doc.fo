                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>)) <basic-link internal-destination="TEI.att.datable" text-decoration="underline">att.datable</basic-link> (<inline>@calendar</inline>, <inline>@period</inline>)  (<basic-link internal-destination="TEI.att.datable.w3c" text-decoration="underline">att.datable.w3c</basic-link> (<inline>@when</inline>, <inline>@notBefore</inline>, <inline>@notAfter</inline>, <inline>@from</inline>, <inline>@to</inline>))</block>
