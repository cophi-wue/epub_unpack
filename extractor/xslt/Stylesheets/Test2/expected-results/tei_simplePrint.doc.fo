                                 <basic-link internal-destination="TEI.code" text-decoration="underline">code</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">textstructure: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.floatingText" text-decoration="underline">floatingText</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">transcr: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link>
                                 <basic-link internal-destination="TEI.subst" text-decoration="underline">subst</basic-link>
                                 <basic-link internal-destination="TEI.supplied" text-decoration="underline">supplied</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">verse: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.rhyme" text-decoration="underline">rhyme</basic-link>
                              </inline>
                           </block>
                           <block>character data</block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">The <basic-link internal-destination="TEI.ab" text-decoration="underline">&lt;ab&gt;</basic-link> element may be used at the encoder's discretion to mark any component-level elements in a text for which no other more specific appropriate markup is defined.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;div type="book" n="Genesis"&gt;</inline>
 <inline>&lt;div type="chapter" n="1"&gt;</inline>
  <inline>&lt;ab&gt;</inline>In the beginning God created the heaven and the earth.<inline>&lt;/ab&gt;</inline>
  <inline>&lt;ab&gt;</inline>And the earth was without form, and void; and
     darkness was upon the face of the deep. And the
     spirit of God moved upon the face of the waters.<inline>&lt;/ab&gt;</inline>
  <inline>&lt;ab&gt;</inline>And God said, Let there be light: and there was light.<inline>&lt;/ab&gt;</inline>
                           <inline>&lt;!-- ...--&gt;</inline>
 <inline>&lt;/div&gt;</inline>
                           <inline>&lt;/div&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;s:report test="(ancestor::tei:p or ancestor::tei:ab) and not(parent::tei:exemplum 
 |parent::tei:item |parent::tei:note |parent::tei:q |parent::tei:quote 
 |parent::tei:remarks |parent::tei:said |parent::tei:sp |parent::tei:stage 
 |parent::tei:cell |parent::tei:figure)"&gt; Abstract model violation: ab may not contain paragraphs or other ab elements.
&lt;/s:report&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
