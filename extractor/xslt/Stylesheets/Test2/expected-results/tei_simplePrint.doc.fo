                              <inline font-weight="bold">header: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.editionStmt" text-decoration="underline">editionStmt</basic-link>
                                 <basic-link internal-destination="TEI.extent" text-decoration="underline">extent</basic-link>
                                 <basic-link internal-destination="TEI.notesStmt" text-decoration="underline">notesStmt</basic-link>
                                 <basic-link internal-destination="TEI.publicationStmt" text-decoration="underline">publicationStmt</basic-link>
                                 <basic-link internal-destination="TEI.seriesStmt" text-decoration="underline">seriesStmt</basic-link>
