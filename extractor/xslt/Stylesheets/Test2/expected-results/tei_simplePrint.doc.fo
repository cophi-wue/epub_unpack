               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e102058">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>type</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>characterizes the element in some sense, using any convenient classification scheme or typology.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e102065">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.enumerated"
                                                                  text-decoration="underline">teidata.enumerated</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>
                                                      <block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;div type="verse"&gt;</inline>
 <inline>&lt;head&gt;</inline>Night in Tarras<inline>&lt;/head&gt;</inline>
 <inline>&lt;lg type="stanza"&gt;</inline>
  <inline>&lt;l&gt;</inline>At evening tramping on the hot white road<inline>&lt;/l&gt;</inline>
  <inline>&lt;l&gt;</inline>…<inline>&lt;/l&gt;</inline>
 <inline>&lt;/lg&gt;</inline>
 <inline>&lt;lg type="stanza"&gt;</inline>
  <inline>&lt;l&gt;</inline>A wind sprang up from nowhere as the sky<inline>&lt;/l&gt;</inline>
  <inline>&lt;l&gt;</inline>…<inline>&lt;/l&gt;</inline>
 <inline>&lt;/lg&gt;</inline>
                                                         <inline>&lt;/div&gt;</inline>
                                                      </block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">The <inline font-style="italic">type</inline> attribute is present on a number of elements, not all of which are members of <inline color="black" font-family="Helvetica">att.typed</inline>, usually because these elements restrict the possible values for the attribute in a specific way.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>subtype</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>provides a sub-categorization of the element, if needed<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e102113">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.enumerated"
                                                                  text-decoration="underline">teidata.enumerated</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">The <inline font-style="italic">subtype</inline> attribute may be used to provide any sub-classification for the element additional to that provided by its <inline font-style="italic">type</inline> attribute.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;sch:rule context="tei:*[@subtype]"&gt;
&lt;sch:assert test="@type"&gt;The &lt;sch:name/&gt; element should not be categorized in detail with @subtype unless also categorized in general with @type&lt;/sch:assert&gt;
&lt;/sch:rule&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">When appropriate, values from an established typology should be used. Alternatively a typology may be defined in the associated TEI header. If values are to be taken from a project-specific list, this should be defined using the <inline hyphenate="false" color="black" font-family="Courier">&lt;valList&gt;</inline> element in the project-specific schema description, as described in <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/USE.html#MDMDAL)">23.3.1.4. Modification of Attribute and Attribute Value Lists</basic-link> .</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.written"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.39. att.written</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e102166">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.written</inline> provides an attribute to indicate the hand in which the textual content of an element was written in the source being transcribed. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STECAT)">1.3.1. Attribute Classes</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Members</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline>
                           <basic-link internal-destination="TEI.att.transcriptional"
                                       text-decoration="underline">att.transcriptional</basic-link>
                           <inline>[<basic-link internal-destination="TEI.add" text-decoration="underline">add</basic-link>
                              <basic-link internal-destination="TEI.del" text-decoration="underline">del</basic-link>
                              <basic-link internal-destination="TEI.subst" text-decoration="underline">subst</basic-link>]</inline>
                           <basic-link internal-destination="TEI.ab" text-decoration="underline">ab</basic-link>
                           <basic-link internal-destination="TEI.closer" text-decoration="underline">closer</basic-link>
                           <basic-link internal-destination="TEI.div" text-decoration="underline">div</basic-link>
                           <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link>
                           <basic-link internal-destination="TEI.head" text-decoration="underline">head</basic-link>
                           <basic-link internal-destination="TEI.hi" text-decoration="underline">hi</basic-link>
                           <basic-link internal-destination="TEI.label" text-decoration="underline">label</basic-link>
                           <basic-link internal-destination="TEI.note" text-decoration="underline">note</basic-link>
                           <basic-link internal-destination="TEI.opener" text-decoration="underline">opener</basic-link>
                           <basic-link internal-destination="TEI.p" text-decoration="underline">p</basic-link>
                           <basic-link internal-destination="TEI.salute" text-decoration="underline">salute</basic-link>
                           <basic-link internal-destination="TEI.seg" text-decoration="underline">seg</basic-link>
                           <basic-link internal-destination="TEI.signed" text-decoration="underline">signed</basic-link>
                           <basic-link internal-destination="TEI.text" text-decoration="underline">text</basic-link>
                           <basic-link internal-destination="TEI.zone" text-decoration="underline">zone</basic-link>
                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e102278">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>hand</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>points to a <inline hyphenate="false" color="black" font-family="Courier">&lt;handNote&gt;</inline> element describing the hand considered responsible for the textual content of the element concerned.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e102287">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
