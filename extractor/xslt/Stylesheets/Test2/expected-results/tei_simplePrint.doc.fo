               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">A floating text has the same content as any other <basic-link internal-destination="TEI.text" text-decoration="underline">&lt;text&gt;</basic-link> and may thus be interrupted by another floating text, or contain a <basic-link internal-destination="TEI.group" text-decoration="underline">&lt;group&gt;</basic-link> of tesselated texts.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;body&gt;</inline>
 <inline>&lt;div type="scene"&gt;</inline>
  <inline>&lt;sp&gt;</inline>
   <inline>&lt;p&gt;</inline>Hush, the players begin...<inline>&lt;/p&gt;</inline>
  <inline>&lt;/sp&gt;</inline>
  <inline>&lt;floatingText type="pwp"&gt;</inline>
   <inline>&lt;body&gt;</inline>
    <inline>&lt;div type="act"&gt;</inline>
     <inline>&lt;sp&gt;</inline>
      <inline>&lt;l&gt;</inline>In Athens our tale takes place [...]<inline>&lt;/l&gt;</inline>
     <inline>&lt;/sp&gt;</inline>
                           <inline>&lt;!-- ... rest of nested act here --&gt;</inline>
    <inline>&lt;/div&gt;</inline>
   <inline>&lt;/body&gt;</inline>
  <inline>&lt;/floatingText&gt;</inline>
  <inline>&lt;sp&gt;</inline>
   <inline>&lt;p&gt;</inline>Now that the play is finished ...<inline>&lt;/p&gt;</inline>
  <inline>&lt;/sp&gt;</inline>
 <inline>&lt;/div&gt;</inline>
                           <inline>&lt;/body&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
