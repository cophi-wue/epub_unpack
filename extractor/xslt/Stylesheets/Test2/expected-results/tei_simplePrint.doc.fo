         <block keep-with-next.within-page="always"
                id="TEI.stage"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.144. &lt;stage&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e73814">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;stage&gt; </inline>(stage direction) contains any kind of stage direction within a dramatic text or fragment. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CODR)">3.12.2. Core Tags for Drama</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CODV)">3.12. Passages of Verse or Drama</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/DR.html#DRSTA)">7.2.4. Stage Directions</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>core</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.ascribed" text-decoration="underline">att.ascribed</basic-link> (<inline>@who</inline>) <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>)) <basic-link internal-destination="TEI.att.placement" text-decoration="underline">att.placement</basic-link> (<inline>@place</inline>) <table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e73934">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>type</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates the kind of stage direction.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e73944">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Recommended</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>0–∞ occurrences of <basic-link internal-destination="TEI.teidata.enumerated"
                                                                  text-decoration="underline">teidata.enumerated</basic-link> separated by whitespace</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Suggested values include:</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <list-block provisional-distance-between-starts="18pt"
                                                                  provisional-label-separation="6pt"
                                                                  text-indent="0em"
                                                                  margin-right="10pt"
                                                                  space-before="6pt"
                                                                  space-after="6pt">
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">setting</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>describes a setting.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">entrance</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>describes an entrance.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">exit</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>describes an exit.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">business</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>describes stage business.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">novelistic</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>is a narrative, motivating stage direction.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">delivery</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>describes how a character speaks.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">modifier</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>gives some detail about a character.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">location</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>describes a location.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">mixed</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>more than one of the above</block>
                                                            </list-item-body>
                                                         </list-item>
                                                      </list-block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">If the value <inline>mixed</inline> is used, it must be the only value. Multiple values may however be supplied if a single stage direction performs multiple functions, for example is both an entrance and a modifier.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Member of</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <basic-link internal-destination="TEI.model.stageLike" text-decoration="underline">model.stageLike</basic-link>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
