                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e98180">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>cert</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>(certainty) signifies the degree of certainty associated with the intervention or interpretation.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e98191">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.probCert" text-decoration="underline">teidata.probCert</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>resp</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>(responsible party) indicates the agency responsible for the intervention or interpretation, for example an editor or transcriber.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e98218">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link> separated by whitespace</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">To reduce the ambiguity of a <inline font-style="italic">resp</inline> pointing directly to a person or organization, we recommend that <inline font-style="italic">resp</inline> be used to point not to an agent (<basic-link internal-destination="TEI.person" text-decoration="underline">&lt;person&gt;</basic-link> or <inline hyphenate="false" color="black" font-family="Courier">&lt;org&gt;</inline>) but to a <basic-link internal-destination="TEI.respStmt" text-decoration="underline">&lt;respStmt&gt;</basic-link>, <basic-link internal-destination="TEI.author" text-decoration="underline">&lt;author&gt;</basic-link>, <basic-link internal-destination="TEI.editor" text-decoration="underline">&lt;editor&gt;</basic-link> or similar element which clarifies the exact role played by the agent. Pointing to multiple <basic-link internal-destination="TEI.respStmt" text-decoration="underline">&lt;respStmt&gt;</basic-link>s allows the encoder to specify clearly each of the roles played in part of a TEI file (creating, transcribing, encoding, editing, proofing etc.).</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">Blessed are the
<inline>&lt;choice&gt;</inline>
 <inline>&lt;sic&gt;</inline>cheesemakers<inline>&lt;/sic&gt;</inline>
 <inline>&lt;corr resp="#editor" cert="high"&gt;</inline>peacemakers<inline>&lt;/corr&gt;</inline>
                           <inline>&lt;/choice&gt;</inline>: for they shall be called the children of God.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;!-- in the &lt;text&gt; ... --&gt;</inline>
                           <inline>&lt;lg&gt;</inline>
                           <inline>&lt;!-- ... --&gt;</inline>
 <inline>&lt;l&gt;</inline>Punkes, Panders, baſe extortionizing
   sla<inline>&lt;choice&gt;</inline>
   <inline>&lt;sic&gt;</inline>n<inline>&lt;/sic&gt;</inline>
   <inline>&lt;corr resp="#JENS1_transcriber"&gt;</inline>u<inline>&lt;/corr&gt;</inline>
  <inline>&lt;/choice&gt;</inline>es,<inline>&lt;/l&gt;</inline>
                           <inline>&lt;!-- ... --&gt;</inline>
                           <inline>&lt;/lg&gt;</inline>
                           <inline>&lt;!-- in the &lt;teiHeader&gt; ... --&gt;</inline>
                           <inline>&lt;!-- ... --&gt;</inline>
                           <inline>&lt;respStmt xml:id="JENS1_transcriber"&gt;</inline>
 <inline>&lt;resp when="2014"&gt;</inline>Transcriber<inline>&lt;/resp&gt;</inline>
 <inline>&lt;name&gt;</inline>Janelle Jenstad<inline>&lt;/name&gt;</inline>
                           <inline>&lt;/respStmt&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.global.source"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.20. att.global.source</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e98311">
