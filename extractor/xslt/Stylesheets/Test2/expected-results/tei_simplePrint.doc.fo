                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>name</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>specifies the full formal name of the namespace concerned.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
