                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;div type="letter"&gt;</inline>
 <inline>&lt;p&gt;</inline> perhaps you will favour me with a sight of it when convenient.<inline>&lt;/p&gt;</inline>
 <inline>&lt;closer&gt;</inline>
  <inline>&lt;salute&gt;</inline>I remain, &amp;amp;c. &amp;amp;c.<inline>&lt;/salute&gt;</inline>
  <inline>&lt;signed&gt;</inline>H. Colburn<inline>&lt;/signed&gt;</inline>
 <inline>&lt;/closer&gt;</inline>
                           <inline>&lt;/div&gt;</inline>
                        </block>
                     </block>
