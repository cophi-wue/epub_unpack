                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;namespace name="http://www.tei-c.org/ns/1.0"&gt;</inline>
 <inline>&lt;tagUsage gi="hi" occurs="28" withId="2"&gt;</inline> Used only to mark English words
   italicized in the copy text <inline>&lt;/tagUsage&gt;</inline>
                           <inline>&lt;/namespace&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;elementRef key="tagUsage" minOccurs="1"
  maxOccurs="unbounded"/&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
