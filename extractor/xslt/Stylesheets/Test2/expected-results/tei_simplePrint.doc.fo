               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">The <basic-link internal-destination="TEI.s" text-decoration="underline">&lt;s&gt;</basic-link> element may be used to mark orthographic sentences, or any other segmentation of a text, provided that the segmentation is end-to-end, complete, and non-nesting. For segmentation which is partial or recursive, the <basic-link internal-destination="TEI.seg" text-decoration="underline">&lt;seg&gt;</basic-link> should be used instead.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">The <inline font-style="italic">type</inline> attribute may be used to indicate the type of segmentation intended, according to any convenient typology.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;head&gt;</inline>
 <inline>&lt;s&gt;</inline>A short affair<inline>&lt;/s&gt;</inline>
                           <inline>&lt;/head&gt;</inline>
                           <inline>&lt;s&gt;</inline>When are you leaving?<inline>&lt;/s&gt;</inline>
                           <inline>&lt;s&gt;</inline>Tomorrow.<inline>&lt;/s&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
