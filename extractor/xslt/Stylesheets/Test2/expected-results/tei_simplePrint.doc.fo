               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;text&gt;</inline>
                           <inline>&lt;!-- Section on Alexander Pope starts --&gt;</inline>
 <inline>&lt;front&gt;</inline>
                           <inline>&lt;!-- biographical notice by editor --&gt;</inline>
 <inline>&lt;/front&gt;</inline>
 <inline>&lt;group&gt;</inline>
  <inline>&lt;text&gt;</inline>
                           <inline>&lt;!-- first poem --&gt;</inline>
  <inline>&lt;/text&gt;</inline>
  <inline>&lt;text&gt;</inline>
                           <inline>&lt;!-- second poem --&gt;</inline>
  <inline>&lt;/text&gt;</inline>
 <inline>&lt;/group&gt;</inline>
                           <inline>&lt;/text&gt;</inline>
                           <inline>&lt;!-- end of Pope section--&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
