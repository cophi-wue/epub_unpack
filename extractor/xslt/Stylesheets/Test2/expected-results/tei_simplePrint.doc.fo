&lt;model predicate="@type='title_page'"
 behaviour="block"&gt;
&lt;outputRendition&gt;border: 1px solid black; padding: 5px;&lt;/outputRendition&gt;
&lt;/model&gt;
&lt;model behaviour="section"
 predicate="parent::body or parent::front or parent::back"/&gt;
&lt;model behaviour="block"/&gt;
    </block>
