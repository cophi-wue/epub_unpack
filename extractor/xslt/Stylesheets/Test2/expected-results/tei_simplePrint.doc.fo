                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;teiCorpus version="5.2" xmlns="http://www.tei-c.org/ns/1.0"&gt;</inline>
 <inline>&lt;teiHeader&gt;</inline>
                           <inline>&lt;!-- header for corpus --&gt;</inline>
 <inline>&lt;/teiHeader&gt;</inline>
 <inline>&lt;TEI&gt;</inline>
  <inline>&lt;teiHeader&gt;</inline>
                           <inline>&lt;!-- header for first text --&gt;</inline>
  <inline>&lt;/teiHeader&gt;</inline>
  <inline>&lt;text&gt;</inline>
                           <inline>&lt;!-- content of first text --&gt;</inline>
  <inline>&lt;/text&gt;</inline>
 <inline>&lt;/TEI&gt;</inline>
 <inline>&lt;TEI&gt;</inline>
  <inline>&lt;teiHeader&gt;</inline>
                           <inline>&lt;!-- header for second text --&gt;</inline>
  <inline>&lt;/teiHeader&gt;</inline>
  <inline>&lt;text&gt;</inline>
                           <inline>&lt;!-- content of second text --&gt;</inline>
  <inline>&lt;/text&gt;</inline>
 <inline>&lt;/TEI&gt;</inline>
                           <inline>&lt;!-- more TEI elements here --&gt;</inline>
                           <inline>&lt;/teiCorpus&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;elementRef key="teiHeader"/&gt;
  &lt;alternate&gt;
   &lt;sequence&gt;
    &lt;classRef key="model.resourceLike"
     minOccurs="1" maxOccurs="unbounded"/&gt;
    &lt;alternate minOccurs="0"
     maxOccurs="unbounded"&gt;
     &lt;elementRef key="TEI"/&gt;
     &lt;elementRef key="teiCorpus"/&gt;
    &lt;/alternate&gt;
   &lt;/sequence&gt;
   &lt;alternate minOccurs="1"
    maxOccurs="unbounded"&gt;
    &lt;elementRef key="TEI"/&gt;
    &lt;elementRef key="teiCorpus"/&gt;
   &lt;/alternate&gt;
  &lt;/alternate&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
