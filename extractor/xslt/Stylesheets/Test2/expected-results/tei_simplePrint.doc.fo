                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.59. &lt;extent&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e32483">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;extent&gt; </inline>describes the approximate size of a text stored on some carrier medium or of some other object, digital or non-digital, specified in any convenient units. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD23)">2.2.3. Type and Extent of File</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD2)">2.2. The File Description</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOI)">3.11.2.4. Imprint, Size of a Document, and Reprint Information</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msph1)">10.7.1. Object Description</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
