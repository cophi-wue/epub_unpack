                                                                      keep-together.within-line="always">role</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the item describes a single role.<inline>[Default] </inline>
                                                               </block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
