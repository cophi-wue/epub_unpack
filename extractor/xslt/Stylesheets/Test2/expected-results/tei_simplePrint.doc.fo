                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;macroRef key="macro.paraContent"/&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
