                     <block>
                        <block>
                           <basic-link internal-destination="TEI.model.linePart" text-decoration="underline">model.linePart</basic-link>
                           <basic-link internal-destination="TEI.model.segLike" text-decoration="underline">model.segLike</basic-link>
                        </block>
