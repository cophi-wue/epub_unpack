                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;address&gt;</inline>
 <inline>&lt;street&gt;</inline>via Marsala 24<inline>&lt;/street&gt;</inline>
 <inline>&lt;postCode&gt;</inline>40126<inline>&lt;/postCode&gt;</inline>
 <inline>&lt;name&gt;</inline>Bologna<inline>&lt;/name&gt;</inline>
 <inline>&lt;name n="I"&gt;</inline>Italy<inline>&lt;/name&gt;</inline>
