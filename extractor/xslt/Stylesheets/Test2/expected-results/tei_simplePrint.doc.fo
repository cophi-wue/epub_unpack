                               space-after.optimum="4pt">
                           <inline>&lt;castList&gt;</inline>
 <inline>&lt;castGroup&gt;</inline>
  <inline>&lt;head rend="braced"&gt;</inline>Mendicants<inline>&lt;/head&gt;</inline>
  <inline>&lt;castItem&gt;</inline>
   <inline>&lt;role&gt;</inline>Aafaa<inline>&lt;/role&gt;</inline>
