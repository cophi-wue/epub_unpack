                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;model behaviour="block"&gt;
&lt;outputRendition&gt;margin-bottom: 0.5em;&lt;/outputRendition&gt;
&lt;/model&gt;
    </block>
                     </block>
