                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.13. &lt;back&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e12021">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;back&gt; </inline>(back matter) contains any appendixes, etc. following the main part of a text. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DSBACK)">4.7. Back Matter</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DS)">4. Default Text Structure</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>textstructure</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
