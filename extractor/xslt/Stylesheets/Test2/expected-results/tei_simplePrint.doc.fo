                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.47. &lt;docDate&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e27614">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;docDate&gt; </inline>(document date) contains the date of a document, as given on a title page or in a dateline. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DSTITL)">4.6. Title Pages</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
