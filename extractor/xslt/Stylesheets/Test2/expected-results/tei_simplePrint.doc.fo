                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element cit
{
   att.global.attributes,
   att.typed.attributes,
   ( model.qLike | model.biblLike | model.ptrLike | model.global )+
}</block>
