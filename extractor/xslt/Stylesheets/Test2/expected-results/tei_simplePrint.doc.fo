                               space-after.optimum="4pt">
                           <inline>&lt;formula notation="none"&gt;</inline>E=mc<inline>&lt;hi rend="sup"&gt;</inline>2<inline>&lt;/hi&gt;</inline>
                           <inline>&lt;/formula&gt;</inline>
                        </block>
