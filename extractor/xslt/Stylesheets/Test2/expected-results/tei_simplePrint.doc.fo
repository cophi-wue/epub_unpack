                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">Must contain one TEI header for the corpus, and a series of <basic-link internal-destination="TEI.TEI" text-decoration="underline">&lt;TEI&gt;</basic-link> elements, one for each text.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">This element is mandatory when applicable.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
