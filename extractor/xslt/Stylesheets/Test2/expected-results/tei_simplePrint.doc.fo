&lt;content&gt;
 &lt;sequence&gt;
  &lt;elementRef key="front" minOccurs="0"/&gt;
  &lt;alternate minOccurs="1"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.graphicLike"/&gt;
   &lt;elementRef key="surface"/&gt;
   &lt;elementRef key="surfaceGrp"/&gt;
  &lt;/alternate&gt;
  &lt;elementRef key="back" minOccurs="0"/&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
