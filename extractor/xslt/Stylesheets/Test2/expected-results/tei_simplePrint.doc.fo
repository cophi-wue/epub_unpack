                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell padding="2pt" text-align="left">
                     <block>note</block>
                  </table-cell>
                  <table-cell padding="2pt" text-align="left">
                     <block>note </block>
                  </table-cell>
                  <table-cell padding="2pt" text-align="left">
                     <block>create a note, often out of line, depending on the value of place; could be margin, footnote, endnote, inline</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell padding="2pt" text-align="left">
                     <block>omit</block>
                  </table-cell>
                  <table-cell padding="2pt" text-align="left">
