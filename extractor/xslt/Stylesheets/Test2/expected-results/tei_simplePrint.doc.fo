         <block keep-with-next.within-page="always"
                id="TEI.listPrefixDef"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.93. &lt;listPrefixDef&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e49635">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;listPrefixDef&gt; </inline>(list of prefix definitions) contains a list of definitions of prefixing schemes used in <inline color="black" font-family="Helvetica">data.pointer</inline> values, showing how abbreviated URIs using each scheme may be expanded into full URIs. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/SA.html#SAPU)">16.2.3. Using Abbreviated Pointers</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>header</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>))</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Member of</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <basic-link internal-destination="TEI.model.encodingDescPart"
                                       text-decoration="underline">model.encodingDescPart</basic-link>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Contained by</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <block>
                                 <inline font-weight="bold">header: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.encodingDesc" text-decoration="underline">encodingDesc</basic-link>
                                    <basic-link internal-destination="TEI.listPrefixDef" text-decoration="underline">listPrefixDef</basic-link>
                                 </inline>
                              </block>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">May contain</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <inline font-weight="bold">header: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.listPrefixDef" text-decoration="underline">listPrefixDef</basic-link>
                                 <basic-link internal-destination="TEI.prefixDef" text-decoration="underline">prefixDef</basic-link>
                              </inline>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>In this example, two private URI scheme prefixes are defined and patterns are provided for dereferencing them. Each prefix is also supplied with a human-readable explanation in a <basic-link internal-destination="TEI.p" text-decoration="underline">&lt;p&gt;</basic-link> element.<block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;listPrefixDef&gt;</inline>
 <inline>&lt;prefixDef ident="psn"
  matchPattern="([A-Z]+)"
  replacementPattern="personography.xml#$1"&gt;</inline>
  <inline>&lt;p&gt;</inline> Private URIs using the <inline>&lt;code&gt;</inline>psn<inline>&lt;/code&gt;</inline> 
     prefix are pointers to <inline>&lt;gi&gt;</inline>person<inline>&lt;/gi&gt;</inline> 
     elements in the personography.xml file.
     For example, <inline>&lt;code&gt;</inline>psn:MDH<inline>&lt;/code&gt;</inline> 
     dereferences to <inline>&lt;code&gt;</inline>personography.xml#MDH<inline>&lt;/code&gt;</inline>.
  <inline>&lt;/p&gt;</inline>
 <inline>&lt;/prefixDef&gt;</inline>
 <inline>&lt;prefixDef ident="bibl"
  matchPattern="([a-z]+[a-z0-9]*)"
  replacementPattern="http://www.example.com/getBibl.xql?id=$1"&gt;</inline>
  <inline>&lt;p&gt;</inline> Private URIs using the <inline>&lt;code&gt;</inline>bibl<inline>&lt;/code&gt;</inline> prefix can be
     expanded to form URIs which retrieve the relevant
     bibliographical reference from www.example.com.
  <inline>&lt;/p&gt;</inline>
 <inline>&lt;/prefixDef&gt;</inline>
                           <inline>&lt;/listPrefixDef&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="1"
  maxOccurs="unbounded"&gt;
  &lt;elementRef key="prefixDef"/&gt;
  &lt;elementRef key="listPrefixDef"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schema Declaration</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element listPrefixDef { att.global.attributes, ( prefixDef | listPrefixDef )+ }</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.mapping"
