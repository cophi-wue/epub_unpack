                                 <table-cell padding="2pt" text-align="left">
                                    <block>type</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>characterizes the cast item.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e15890">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
