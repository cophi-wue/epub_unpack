                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;titleStmt&gt;</inline>
 <inline>&lt;title&gt;</inline> ... <inline>&lt;/title&gt;</inline>
 <inline>&lt;editor xml:id="LDB"&gt;</inline>Lou Burnard<inline>&lt;/editor&gt;</inline>
 <inline>&lt;respStmt xml:id="BZ"&gt;</inline>
  <inline>&lt;resp&gt;</inline>copy editing<inline>&lt;/resp&gt;</inline>
  <inline>&lt;name&gt;</inline>Brett Zamir<inline>&lt;/name&gt;</inline>
 <inline>&lt;/respStmt&gt;</inline>
                           <inline>&lt;/titleStmt&gt;</inline>
                           <inline>&lt;!-- ... --&gt;</inline>
                           <inline>&lt;revisionDesc status="published"&gt;</inline>
 <inline>&lt;change who="#BZ" when="2008-02-02"
  status="public"&gt;</inline>Finished chapter 23<inline>&lt;/change&gt;</inline>
 <inline>&lt;change who="#BZ" when="2008-01-02"
  status="draft"&gt;</inline>Finished chapter 2<inline>&lt;/change&gt;</inline>
 <inline>&lt;change n="P2.2" when="1991-12-21"
  who="#LDB"&gt;</inline>Added examples to section 3<inline>&lt;/change&gt;</inline>
 <inline>&lt;change when="1991-11-11" who="#MSM"&gt;</inline>Deleted chapter 10<inline>&lt;/change&gt;</inline>
                           <inline>&lt;/revisionDesc&gt;</inline>
                        </block>
                     </block>
