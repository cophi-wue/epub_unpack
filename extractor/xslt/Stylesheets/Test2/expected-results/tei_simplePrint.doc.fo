                               space-after.optimum="4pt">
element name
{
   att.global.attributes,
   att.personal.attributes,
   att.datable.attributes,
   att.editLike.attributes,
   att.typed.attribute.subtype,
   attribute type
   {
      "person"
    | "forename"
    | "surname"
    | "personGenName"
    | "personRoleName"
    | "personAddName"
    | "nameLink"
    | "org"
    | "country"
    | "placeGeog"
    | "place"
   }?,
   macro.phraseSeq
}</block>
