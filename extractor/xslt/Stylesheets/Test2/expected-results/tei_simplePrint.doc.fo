                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>scope</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>where the measurement summarizes more than one observation, specifies the applicability of this measurement.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e92303">
                                          <table-column column-number="1" column-width="20%"/>
