                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;set&gt;</inline>
 <inline>&lt;head&gt;</inline>SCENE<inline>&lt;/head&gt;</inline>
 <inline>&lt;p&gt;</inline>A Sub-Post Office on a late autumn evening<inline>&lt;/p&gt;</inline>
                           <inline>&lt;/set&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;front&gt;</inline>
                           <inline>&lt;!-- &lt;titlePage&gt;, &lt;div type="Dedication"&gt;, etc. --&gt;</inline>
 <inline>&lt;set&gt;</inline>
  <inline>&lt;list type="gloss"&gt;</inline>
   <inline>&lt;label&gt;</inline>TIME<inline>&lt;/label&gt;</inline>
   <inline>&lt;item&gt;</inline>1907<inline>&lt;/item&gt;</inline>
   <inline>&lt;label&gt;</inline>PLACE<inline>&lt;/label&gt;</inline>
   <inline>&lt;item&gt;</inline>East Coast village in England<inline>&lt;/item&gt;</inline>
  <inline>&lt;/list&gt;</inline>
 <inline>&lt;/set&gt;</inline>
                           <inline>&lt;/front&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
