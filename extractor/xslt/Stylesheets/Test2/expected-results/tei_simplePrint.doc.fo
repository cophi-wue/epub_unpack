                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;model predicate="bibl" behaviour="list"&gt;
&lt;param name="content" value="bibl"/&gt;
&lt;/model&gt;
&lt;model behaviour="block"/&gt;
    </block>
                     </block>
                  </table-cell>
