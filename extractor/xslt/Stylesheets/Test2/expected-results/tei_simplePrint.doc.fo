                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate&gt;
  &lt;elementRef key="term" minOccurs="1"
   maxOccurs="unbounded"/&gt;
  &lt;elementRef key="list"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
