                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;figure&gt;</inline>
 <inline>&lt;head&gt;</inline>The View from the Bridge<inline>&lt;/head&gt;</inline>
 <inline>&lt;figDesc&gt;</inline>A Whistleresque view showing four or five sailing boats in the foreground, and a
   series of buoys strung out between them.<inline>&lt;/figDesc&gt;</inline>
 <inline>&lt;graphic url="http://www.example.org/fig1.png"
  scale="0.5"/&gt;</inline>
                           <inline>&lt;/figure&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
