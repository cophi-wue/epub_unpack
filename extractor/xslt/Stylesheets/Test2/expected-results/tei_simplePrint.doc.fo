         <block keep-with-next.within-page="always"
                id="TEI.abbr"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.3. &lt;abbr&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e7049">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;abbr&gt; </inline>(abbreviation) contains an abbreviation of any sort. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONAAB)">3.5.5. Abbreviations and Their Expansions</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>core</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>)) <basic-link internal-destination="TEI.att.typed" text-decoration="underline">att.typed</basic-link> (<inline>type</inline>, @subtype) <table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e7153">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>type</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>allows the encoder to classify the abbreviation according to some convenient typology.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e7162">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Derived from</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.att.typed" text-decoration="underline">att.typed</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.enumerated"
                                                                  text-decoration="underline">teidata.enumerated</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Sample values include:</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <list-block provisional-distance-between-starts="18pt"
                                                                  provisional-label-separation="6pt"
                                                                  text-indent="0em"
                                                                  margin-right="10pt"
                                                                  space-before="6pt"
                                                                  space-after="6pt">
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">suspension</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the abbreviation provides the first letter(s) of the word or phrase, omitting the remainder.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">contraction</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the abbreviation omits some letter(s) in the middle.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">brevigraph</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the abbreviation comprises a special symbol or mark.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">superscription</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the abbreviation includes writing above the line.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">acronym</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the abbreviation comprises the initial letters of the words of a phrase.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">title</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the abbreviation is for a title of address (Dr, Ms, Mr, …)</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">organization</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the abbreviation is for the name of an organization.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">geographic</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the abbreviation is for a geographic name.</block>
                                                            </list-item-body>
                                                         </list-item>
                                                      </list-block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Member of</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <basic-link internal-destination="TEI.model.choicePart" text-decoration="underline">model.choicePart</basic-link>
                           <basic-link internal-destination="TEI.model.pPart.editorial"
                                       text-decoration="underline">model.pPart.editorial</basic-link>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Contained by</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <block>
                                 <inline font-weight="bold">analysis: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.pc" text-decoration="underline">pc</basic-link>
                                    <basic-link internal-destination="TEI.s" text-decoration="underline">s</basic-link>
                                    <basic-link internal-destination="TEI.w" text-decoration="underline">w</basic-link>
                                 </inline>
                              </block>
                              <block>
                                 <inline font-weight="bold">core: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.abbr" text-decoration="underline">abbr</basic-link>
                                    <basic-link internal-destination="TEI.add" text-decoration="underline">add</basic-link>
                                    <basic-link internal-destination="TEI.addrLine" text-decoration="underline">addrLine</basic-link>
                                    <basic-link internal-destination="TEI.author" text-decoration="underline">author</basic-link>
                                    <basic-link internal-destination="TEI.bibl" text-decoration="underline">bibl</basic-link>
                                    <basic-link internal-destination="TEI.biblScope" text-decoration="underline">biblScope</basic-link>
                                    <basic-link internal-destination="TEI.choice" text-decoration="underline">choice</basic-link>
                                    <basic-link internal-destination="TEI.corr" text-decoration="underline">corr</basic-link>
                                    <basic-link internal-destination="TEI.date" text-decoration="underline">date</basic-link>
                                    <basic-link internal-destination="TEI.del" text-decoration="underline">del</basic-link>
                                    <basic-link internal-destination="TEI.desc" text-decoration="underline">desc</basic-link>
                                    <basic-link internal-destination="TEI.editor" text-decoration="underline">editor</basic-link>
                                    <basic-link internal-destination="TEI.email" text-decoration="underline">email</basic-link>
                                    <basic-link internal-destination="TEI.expan" text-decoration="underline">expan</basic-link>
                                    <basic-link internal-destination="TEI.foreign" text-decoration="underline">foreign</basic-link>
                                    <basic-link internal-destination="TEI.head" text-decoration="underline">head</basic-link>
                                    <basic-link internal-destination="TEI.hi" text-decoration="underline">hi</basic-link>
                                    <basic-link internal-destination="TEI.item" text-decoration="underline">item</basic-link>
                                    <basic-link internal-destination="TEI.l" text-decoration="underline">l</basic-link>
                                    <basic-link internal-destination="TEI.label" text-decoration="underline">label</basic-link>
                                    <basic-link internal-destination="TEI.measure" text-decoration="underline">measure</basic-link>
                                    <basic-link internal-destination="TEI.name" text-decoration="underline">name</basic-link>
                                    <basic-link internal-destination="TEI.note" text-decoration="underline">note</basic-link>
                                    <basic-link internal-destination="TEI.num" text-decoration="underline">num</basic-link>
                                    <basic-link internal-destination="TEI.orig" text-decoration="underline">orig</basic-link>
                                    <basic-link internal-destination="TEI.p" text-decoration="underline">p</basic-link>
                                    <basic-link internal-destination="TEI.pubPlace" text-decoration="underline">pubPlace</basic-link>
                                    <basic-link internal-destination="TEI.publisher" text-decoration="underline">publisher</basic-link>
                                    <basic-link internal-destination="TEI.q" text-decoration="underline">q</basic-link>
                                    <basic-link internal-destination="TEI.quote" text-decoration="underline">quote</basic-link>
                                    <basic-link internal-destination="TEI.ref" text-decoration="underline">ref</basic-link>
                                    <basic-link internal-destination="TEI.reg" text-decoration="underline">reg</basic-link>
