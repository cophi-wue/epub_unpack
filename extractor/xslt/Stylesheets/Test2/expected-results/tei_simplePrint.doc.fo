                        </inline>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes<table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e96259">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>corresp</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>(corresponds) points to elements that correspond to the current element in some way.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e96270">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link> separated by whitespace</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>
                                                      <block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;group&gt;</inline>
 <inline>&lt;text xml:id="t1-g1-t1"
  xml:lang="mi"&gt;</inline>
  <inline>&lt;body xml:id="t1-g1-t1-body1"&gt;</inline>
   <inline>&lt;div type="chapter"&gt;</inline>
    <inline>&lt;head&gt;</inline>He Whakamaramatanga mo te Ture Hoko, Riihi hoki, i nga Whenua Maori, 1876.<inline>&lt;/head&gt;</inline>
    <inline>&lt;p&gt;</inline>…<inline>&lt;/p&gt;</inline>
   <inline>&lt;/div&gt;</inline>
  <inline>&lt;/body&gt;</inline>
 <inline>&lt;/text&gt;</inline>
 <inline>&lt;text xml:id="t1-g1-t2"
  xml:lang="en"&gt;</inline>
  <inline>&lt;body xml:id="t1-g1-t2-body1"
   corresp="#t1-g1-t1-body1"&gt;</inline>
   <inline>&lt;div type="chapter"&gt;</inline>
    <inline>&lt;head&gt;</inline>An Act to regulate the Sale, Letting, and Disposal of Native Lands, 1876.<inline>&lt;/head&gt;</inline>
    <inline>&lt;p&gt;</inline>…<inline>&lt;/p&gt;</inline>
   <inline>&lt;/div&gt;</inline>
  <inline>&lt;/body&gt;</inline>
 <inline>&lt;/text&gt;</inline>
                                                         <inline>&lt;/group&gt;</inline>
                                                      </block>In this example a <basic-link internal-destination="TEI.group" text-decoration="underline">&lt;group&gt;</basic-link> contains two <basic-link internal-destination="TEI.text" text-decoration="underline">&lt;text&gt;</basic-link>s, each containing the same document in a different language. The correspondence is indicated using <inline font-style="italic">corresp</inline>. The language is indicated using <inline font-family="Courier">xml:lang</inline>, whose value is inherited; both the tag with the <inline font-style="italic">corresp</inline> and the tag pointed to by the <inline font-style="italic">corresp</inline> inherit the value from their immediate parent.</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>
                                                      <block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;!-- In a placeography --&gt;</inline>
                                                         <inline>&lt;place xml:id="LOND1"
 corresp="#LOND2 #GENI1"&gt;</inline>
 <inline>&lt;placeName&gt;</inline>London<inline>&lt;/placeName&gt;</inline>
 <inline>&lt;desc&gt;</inline>The city of London...<inline>&lt;/desc&gt;</inline>
                                                         <inline>&lt;/place&gt;</inline>
                                                         <inline>&lt;!-- In a literary personography --&gt;</inline>
                                                         <inline>&lt;person xml:id="LOND2"
 corresp="#LOND1 #GENI1"&gt;</inline>
 <inline>&lt;persName type="lit"&gt;</inline>London<inline>&lt;/persName&gt;</inline>
 <inline>&lt;note&gt;</inline>
  <inline>&lt;p&gt;</inline>Allegorical character representing the city of <inline>&lt;ref target="LOND1.xml"&gt;</inline>London<inline>&lt;/ref&gt;</inline>.
  <inline>&lt;/p&gt;</inline>
 <inline>&lt;/note&gt;</inline>
                                                         <inline>&lt;/person&gt;</inline>
                                                         <inline>&lt;person xml:id="GENI1"
 corresp="#LOND1 #LOND2"&gt;</inline>
 <inline>&lt;persName type="lit"&gt;</inline>London’s Genius<inline>&lt;/persName&gt;</inline>
 <inline>&lt;note&gt;</inline>
  <inline>&lt;p&gt;</inline>Personification of London’s genius. Appears as an
     allegorical character in mayoral shows.
  <inline>&lt;/p&gt;</inline>
 <inline>&lt;/note&gt;</inline>
                                                         <inline>&lt;/person&gt;</inline>
                                                      </block>In this example, a <basic-link internal-destination="TEI.place" text-decoration="underline">&lt;place&gt;</basic-link> element containing information about the city of London is linked with two <basic-link internal-destination="TEI.person" text-decoration="underline">&lt;person&gt;</basic-link> elements in a literary personography. This correspondence represents a slightly looser relationship than the one in the preceding example; there is no sense in which an allegorical character could be substituted for the physical city, or vice versa, but there is obviously a correspondence between them.</block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>next</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>points to the next element of a virtual aggregate of which the current element is part.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e96363">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>prev</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>(previous) points to the previous element of a virtual aggregate of which the current element is part.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e96390">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.global.rendition"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.18. att.global.rendition</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e96409">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
