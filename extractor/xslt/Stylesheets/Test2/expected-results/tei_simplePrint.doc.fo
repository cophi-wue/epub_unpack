                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">Proper nouns referring to people, places, and organizations may be tagged instead with <inline hyphenate="false" color="black" font-family="Courier">&lt;persName&gt;</inline>, <inline hyphenate="false" color="black" font-family="Courier">&lt;placeName&gt;</inline>, or <inline hyphenate="false" color="black" font-family="Courier">&lt;orgName&gt;</inline>, when the TEI module for names and dates is included.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;name type="person"&gt;</inline>Thomas Hoccleve<inline>&lt;/name&gt;</inline>
                           <inline>&lt;name type="place"&gt;</inline>Villingaholt<inline>&lt;/name&gt;</inline>
                           <inline>&lt;name type="org"&gt;</inline>Vetus Latina Institut<inline>&lt;/name&gt;</inline>
                           <inline>&lt;name type="person" ref="#HOC001"&gt;</inline>Occleve<inline>&lt;/name&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
