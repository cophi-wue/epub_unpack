                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;biblScope&gt;</inline>pp 12–34<inline>&lt;/biblScope&gt;</inline>
                           <inline>&lt;biblScope unit="page" from="12" to="34"/&gt;</inline>
                           <inline>&lt;biblScope unit="volume"&gt;</inline>II<inline>&lt;/biblScope&gt;</inline>
                           <inline>&lt;biblScope unit="page"&gt;</inline>12<inline>&lt;/biblScope&gt;</inline>
                        </block>
