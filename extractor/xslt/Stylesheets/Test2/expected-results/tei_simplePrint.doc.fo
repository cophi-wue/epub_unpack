         <block keep-with-next.within-page="always"
                id="TEI.unclear"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.163. &lt;unclear&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e83372">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;unclear&gt; </inline>contains a word, phrase, or passage which cannot be transcribed with certainty because it is illegible or inaudible in the source. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHDA)">11.3.3.1. Damage, Illegibility, and Supplied Text</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDADD)">3.4.3. Additions, Deletions, and Omissions</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>core</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>)) <basic-link internal-destination="TEI.att.editLike" text-decoration="underline">att.editLike</basic-link> (<basic-link internal-destination="TEI.att.dimensions" text-decoration="underline">att.dimensions</basic-link> (<inline>@unit</inline>, <inline>@quantity</inline>, <inline>@extent</inline>, <inline>@scope</inline>)) <table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e83487">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>reason</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates why the material is hard to transcribe.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e83496">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.word" text-decoration="underline">teidata.word</basic-link> separated by whitespace</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>
                                                      <block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;div&gt;</inline>
 <inline>&lt;head&gt;</inline>Rx<inline>&lt;/head&gt;</inline>
 <inline>&lt;p&gt;</inline>500 mg <inline>&lt;unclear reason="illegible"&gt;</inline>placebo<inline>&lt;/unclear&gt;</inline>
 <inline>&lt;/p&gt;</inline>
                                                         <inline>&lt;/div&gt;</inline>
                                                      </block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">One or more words may be used to describe the reason; usually each word will refer to a single cause. Typical examples might thus include <inline font-style="italic" font-weight="normal">faded</inline>, <inline font-style="italic" font-weight="normal">illegible</inline>, <inline font-style="italic" font-weight="normal">eccentric_ductus</inline>
                                                         <inline font-style="italic" font-weight="normal">background_noise</inline>, <inline font-style="italic" font-weight="normal">passing_truck</inline>,etc.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>agent</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>Where the difficulty in transcription arises from damage, categorizes the cause of the damage, if it can be identified.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e83553">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.enumerated"
                                                                  text-decoration="underline">teidata.enumerated</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Sample values include:</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <list-block provisional-distance-between-starts="18pt"
                                                                  provisional-label-separation="6pt"
                                                                  text-indent="0em"
                                                                  margin-right="10pt"
                                                                  space-before="6pt"
                                                                  space-after="6pt">
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">rubbing</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>damage results from rubbing of the leaf edges</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">mildew</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>damage results from mildew on the leaf surface</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">smoke</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>damage results from smoke</block>
                                                            </list-item-body>
                                                         </list-item>
                                                      </list-block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
