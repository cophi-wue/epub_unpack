                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;titlePage&gt;</inline>
 <inline>&lt;docTitle&gt;</inline>
  <inline>&lt;titlePart&gt;</inline>Travels into Several Remote Nations of the World, in Four
     Parts.<inline>&lt;/titlePart&gt;</inline>
 <inline>&lt;/docTitle&gt;</inline>
 <inline>&lt;byline&gt;</inline> By <inline>&lt;docAuthor&gt;</inline>Lemuel Gulliver<inline>&lt;/docAuthor&gt;</inline>, First a Surgeon,
   and then a Captain of several Ships<inline>&lt;/byline&gt;</inline>
                           <inline>&lt;/titlePage&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
