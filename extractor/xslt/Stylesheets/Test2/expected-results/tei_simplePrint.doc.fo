                                 <basic-link internal-destination="TEI.bibl" text-decoration="underline">bibl</basic-link>
                                 <basic-link internal-destination="TEI.choice" text-decoration="underline">choice</basic-link>
                                 <basic-link internal-destination="TEI.cit" text-decoration="underline">cit</basic-link>
                                 <basic-link internal-destination="TEI.date" text-decoration="underline">date</basic-link>
                                 <basic-link internal-destination="TEI.desc" text-decoration="underline">desc</basic-link>
                                 <basic-link internal-destination="TEI.email" text-decoration="underline">email</basic-link>
                                 <basic-link internal-destination="TEI.expan" text-decoration="underline">expan</basic-link>
                                 <basic-link internal-destination="TEI.foreign" text-decoration="underline">foreign</basic-link>
                                 <basic-link internal-destination="TEI.hi" text-decoration="underline">hi</basic-link>
                                 <basic-link internal-destination="TEI.label" text-decoration="underline">label</basic-link>
                                 <basic-link internal-destination="TEI.list" text-decoration="underline">list</basic-link>
                                 <basic-link internal-destination="TEI.listBibl" text-decoration="underline">listBibl</basic-link>
                                 <basic-link internal-destination="TEI.measure" text-decoration="underline">measure</basic-link>
                                 <basic-link internal-destination="TEI.name" text-decoration="underline">name</basic-link>
                                 <basic-link internal-destination="TEI.num" text-decoration="underline">num</basic-link>
                                 <basic-link internal-destination="TEI.q" text-decoration="underline">q</basic-link>
                                 <basic-link internal-destination="TEI.quote" text-decoration="underline">quote</basic-link>
                                 <basic-link internal-destination="TEI.ref" text-decoration="underline">ref</basic-link>
                                 <basic-link internal-destination="TEI.rs" text-decoration="underline">rs</basic-link>
                                 <basic-link internal-destination="TEI.stage" text-decoration="underline">stage</basic-link>
                                 <basic-link internal-destination="TEI.term" text-decoration="underline">term</basic-link>
                                 <basic-link internal-destination="TEI.time" text-decoration="underline">time</basic-link>
                                 <basic-link internal-destination="TEI.title" text-decoration="underline">title</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">drama: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.castList" text-decoration="underline">castList</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">figures: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.table" text-decoration="underline">table</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">header: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.biblFull" text-decoration="underline">biblFull</basic-link>
                                 <basic-link internal-destination="TEI.idno" text-decoration="underline">idno</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">namesdates: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.listPerson" text-decoration="underline">listPerson</basic-link>
                                 <basic-link internal-destination="TEI.listPlace" text-decoration="underline">listPlace</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">tagdocs: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.code" text-decoration="underline">code</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">textstructure: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.floatingText" text-decoration="underline">floatingText</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">transcr: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.subst" text-decoration="underline">subst</basic-link>
                              </inline>
