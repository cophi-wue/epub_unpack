                     <block>
                        <block line-height="1">Contains paragraphs or phrase level tags.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">This element should not be used outside the front or back matter; for similar contextual descriptions within the body of the text, use the <basic-link internal-destination="TEI.stage" text-decoration="underline">&lt;stage&gt;</basic-link> element.</block>
                     </block>
