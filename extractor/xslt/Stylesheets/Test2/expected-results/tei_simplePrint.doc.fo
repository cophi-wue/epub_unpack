                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <inline font-weight="bold">analysis: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.c" text-decoration="underline">c</basic-link>
                                 <basic-link internal-destination="TEI.pc" text-decoration="underline">pc</basic-link>
                                 <basic-link internal-destination="TEI.s" text-decoration="underline">s</basic-link>
                                 <basic-link internal-destination="TEI.w" text-decoration="underline">w</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">core: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.abbr" text-decoration="underline">abbr</basic-link>
                                 <basic-link internal-destination="TEI.add" text-decoration="underline">add</basic-link>
                                 <basic-link internal-destination="TEI.address" text-decoration="underline">address</basic-link>
                                 <basic-link internal-destination="TEI.cb" text-decoration="underline">cb</basic-link>
                                 <basic-link internal-destination="TEI.choice" text-decoration="underline">choice</basic-link>
                                 <basic-link internal-destination="TEI.corr" text-decoration="underline">corr</basic-link>
                                 <basic-link internal-destination="TEI.date" text-decoration="underline">date</basic-link>
                                 <basic-link internal-destination="TEI.del" text-decoration="underline">del</basic-link>
                                 <basic-link internal-destination="TEI.email" text-decoration="underline">email</basic-link>
                                 <basic-link internal-destination="TEI.expan" text-decoration="underline">expan</basic-link>
                                 <basic-link internal-destination="TEI.foreign" text-decoration="underline">foreign</basic-link>
                                 <basic-link internal-destination="TEI.gap" text-decoration="underline">gap</basic-link>
                                 <basic-link internal-destination="TEI.graphic" text-decoration="underline">graphic</basic-link>
                                 <basic-link internal-destination="TEI.hi" text-decoration="underline">hi</basic-link>
                                 <basic-link internal-destination="TEI.lb" text-decoration="underline">lb</basic-link>
                                 <basic-link internal-destination="TEI.measure" text-decoration="underline">measure</basic-link>
                                 <basic-link internal-destination="TEI.milestone" text-decoration="underline">milestone</basic-link>
                                 <basic-link internal-destination="TEI.name" text-decoration="underline">name</basic-link>
                                 <basic-link internal-destination="TEI.note" text-decoration="underline">note</basic-link>
                                 <basic-link internal-destination="TEI.num" text-decoration="underline">num</basic-link>
                                 <basic-link internal-destination="TEI.orig" text-decoration="underline">orig</basic-link>
                                 <basic-link internal-destination="TEI.pb" text-decoration="underline">pb</basic-link>
                                 <basic-link internal-destination="TEI.ref" text-decoration="underline">ref</basic-link>
                                 <basic-link internal-destination="TEI.reg" text-decoration="underline">reg</basic-link>
                                 <basic-link internal-destination="TEI.rs" text-decoration="underline">rs</basic-link>
                                 <basic-link internal-destination="TEI.sic" text-decoration="underline">sic</basic-link>
                                 <basic-link internal-destination="TEI.term" text-decoration="underline">term</basic-link>
                                 <basic-link internal-destination="TEI.time" text-decoration="underline">time</basic-link>
                                 <basic-link internal-destination="TEI.title" text-decoration="underline">title</basic-link>
                                 <basic-link internal-destination="TEI.unclear" text-decoration="underline">unclear</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">figures: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.figure" text-decoration="underline">figure</basic-link>
                                 <basic-link internal-destination="TEI.formula" text-decoration="underline">formula</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">gaiji: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.g" text-decoration="underline">g</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">header: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.idno" text-decoration="underline">idno</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">linking: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.anchor" text-decoration="underline">anchor</basic-link>
                                 <basic-link internal-destination="TEI.seg" text-decoration="underline">seg</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">tagdocs: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.code" text-decoration="underline">code</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">transcr: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link>
                                 <basic-link internal-destination="TEI.subst" text-decoration="underline">subst</basic-link>
                                 <basic-link internal-destination="TEI.supplied" text-decoration="underline">supplied</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">verse: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.rhyme" text-decoration="underline">rhyme</basic-link>
                              </inline>
                           </block>
                           <block>character data</block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Labels are commonly used for the headwords in glossary lists; note the use of the global <inline font-style="italic">xml:lang</inline> attribute to set the default language of the glossary list to Middle English, and identify the glosses and headings as modern English or Latin:<block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;list type="gloss" xml:lang="enm"&gt;</inline>
 <inline>&lt;head xml:lang="en"&gt;</inline>Vocabulary<inline>&lt;/head&gt;</inline>
 <inline>&lt;headLabel xml:lang="en"&gt;</inline>Middle English<inline>&lt;/headLabel&gt;</inline>
 <inline>&lt;headItem xml:lang="en"&gt;</inline>New English<inline>&lt;/headItem&gt;</inline>
 <inline>&lt;label&gt;</inline>nu<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>now<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>lhude<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>loudly<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>bloweth<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>blooms<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>med<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>meadow<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>wude<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>wood<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>awe<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>ewe<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>lhouth<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>lows<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>sterteth<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>bounds, frisks (cf. <inline>&lt;cit&gt;</inline>
   <inline>&lt;ref&gt;</inline>Chaucer, K.T.644<inline>&lt;/ref&gt;</inline>
   <inline>&lt;quote&gt;</inline>a courser, <inline>&lt;term&gt;</inline>sterting<inline>&lt;/term&gt;</inline>as the fyr<inline>&lt;/quote&gt;</inline>
  <inline>&lt;/cit&gt;</inline>
 <inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>verteth<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="la"&gt;</inline>pedit<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>murie<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>merrily<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>swik<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>cease<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>naver<inline>&lt;/label&gt;</inline>
 <inline>&lt;item xml:lang="en"&gt;</inline>never<inline>&lt;/item&gt;</inline>
                           <inline>&lt;/list&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Labels may also be used to record explicitly the numbers or letters which mark list items in ordered lists, as in this extract from Gibbon's <inline font-style="italic">Autobiography</inline>. In this usage the <basic-link internal-destination="TEI.label" text-decoration="underline">&lt;label&gt;</basic-link> element is synonymous with the <inline font-style="italic">n</inline> attribute on the <basic-link internal-destination="TEI.item" text-decoration="underline">&lt;item&gt;</basic-link> element:<block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">I will add two facts, which have seldom occurred
 in the composition of six, or at least of five quartos. <inline>&lt;list rend="runon" type="ordered"&gt;</inline>
 <inline>&lt;label&gt;</inline>(1)<inline>&lt;/label&gt;</inline>
 <inline>&lt;item&gt;</inline>My first rough manuscript, without any intermediate copy, has been sent to the press.<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>(2) <inline>&lt;/label&gt;</inline>
 <inline>&lt;item&gt;</inline>Not a sheet has been seen by any human eyes, excepting those of the author and the
   printer: the faults and the merits are exclusively my own.<inline>&lt;/item&gt;</inline>
                           <inline>&lt;/list&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Labels may also be used for other structured list items, as in this extract from the journal of Edward Gibbon:<block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;list type="gloss"&gt;</inline>
 <inline>&lt;label&gt;</inline>March 1757.<inline>&lt;/label&gt;</inline>
 <inline>&lt;item&gt;</inline>I wrote some critical observations upon Plautus.<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>March 8th.<inline>&lt;/label&gt;</inline>
 <inline>&lt;item&gt;</inline>I wrote a long dissertation upon some lines of Virgil.<inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>June.<inline>&lt;/label&gt;</inline>
 <inline>&lt;item&gt;</inline>I saw Mademoiselle Curchod — <inline>&lt;quote xml:lang="la"&gt;</inline>Omnia vincit amor, et nos cedamus
     amori.<inline>&lt;/quote&gt;</inline>
 <inline>&lt;/item&gt;</inline>
 <inline>&lt;label&gt;</inline>August.<inline>&lt;/label&gt;</inline>
 <inline>&lt;item&gt;</inline>I went to Crassy, and staid two days.<inline>&lt;/item&gt;</inline>
                           <inline>&lt;/list&gt;</inline>
                        </block>Note that the <basic-link internal-destination="TEI.label" text-decoration="underline">&lt;label&gt;</basic-link> might also appear within the <basic-link internal-destination="TEI.item" text-decoration="underline">&lt;item&gt;</basic-link> rather than as its sibling. Though syntactically valid, this usage is not recommended TEI practice.</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Labels may also be used to represent a label or heading attached to a paragraph or sequence of paragraphs not treated as a structural division, or to a group of verse lines. Note that, in this case, the <basic-link internal-destination="TEI.label" text-decoration="underline">&lt;label&gt;</basic-link> element appears <inline font-style="italic">within</inline> the <basic-link internal-destination="TEI.p" text-decoration="underline">&lt;p&gt;</basic-link> or <basic-link internal-destination="TEI.lg" text-decoration="underline">&lt;lg&gt;</basic-link> element, rather than as a preceding sibling of it.<block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;p&gt;</inline>[...]
<inline>&lt;lb/&gt;</inline>&amp;amp; n’entrer en mauuais &amp;amp; mal-heu-
<inline>&lt;lb/&gt;</inline>ré meſnage. Or des que le conſente-
<inline>&lt;lb/&gt;</inline>ment des parties y eſt le mariage eſt
<inline>&lt;lb/&gt;</inline> arreſté, quoy que de faict il ne ſoit
<inline>&lt;label place="margin"&gt;</inline>Puiſſance maritale
   entre les Romains.<inline>&lt;/label&gt;</inline>
 <inline>&lt;lb/&gt;</inline> conſommé. Depuis la conſomma-
<inline>&lt;lb/&gt;</inline>tion du mariage la femme eſt ſoubs
<inline>&lt;lb/&gt;</inline> la puiſſance du mary, s’il n’eſt eſcla-
<inline>&lt;lb/&gt;</inline>ue ou enfant de famille : car en ce
<inline>&lt;lb/&gt;</inline> cas, la femme, qui a eſpouſé vn en-
<inline>&lt;lb/&gt;</inline>fant de famille, eſt ſous la puiſſance
 [...]<inline>&lt;/p&gt;</inline>
                        </block>In this example the text of the label appears in the right hand margin of the original source, next to the paragraph it describes, but approximately in the middle of it. If so desired the <inline font-style="italic">type</inline> attribute may be used to distinguish different categories of label.</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;macroRef key="macro.phraseSeq"/&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schema Declaration</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element label
{
   att.global.attributes,
   att.typed.attributes,
   att.placement.attributes,
   att.written.attributes,
   macro.phraseSeq
}</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Processing Model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;model behaviour="inline"/&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.langUsage"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.83. &lt;langUsage&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e44892">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;langUsage&gt; </inline>(language usage) describes the languages, sublanguages, registers, dialects, etc. represented within a text. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD41)">2.4.2. Language Usage</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD4)">2.4. The Profile Description</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html#CCAS2)">15.3.2. Declarable Elements</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>header</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>))</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
