                               space-after.optimum="4pt">
                           <inline>&lt;listPlace type="offshoreIslands"&gt;</inline>
 <inline>&lt;place&gt;</inline>
  <inline>&lt;placeName&gt;</inline>La roche qui pleure<inline>&lt;/placeName&gt;</inline>
 <inline>&lt;/place&gt;</inline>
 <inline>&lt;place&gt;</inline>
  <inline>&lt;placeName&gt;</inline>Ile aux cerfs<inline>&lt;/placeName&gt;</inline>
 <inline>&lt;/place&gt;</inline>
