                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">The <inline font-style="italic">mimeType</inline> attribute should be used to supply the MIME media type of the image specified by the <inline font-style="italic">url</inline> attribute.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">Within the body of a text, a <basic-link internal-destination="TEI.graphic" text-decoration="underline">&lt;graphic&gt;</basic-link> element indicates the presence of a graphic component in the source itself. Within the context of a <basic-link internal-destination="TEI.facsimile" text-decoration="underline">&lt;facsimile&gt;</basic-link> or <inline hyphenate="false" color="black" font-family="Courier">&lt;sourceDoc&gt;</inline> element, however, a <basic-link internal-destination="TEI.graphic" text-decoration="underline">&lt;graphic&gt;</basic-link> element provides an additional digital representation of some part of the source being encoded.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;figure&gt;</inline>
 <inline>&lt;graphic url="fig1.png"/&gt;</inline>
 <inline>&lt;head&gt;</inline>Figure One: The View from the Bridge<inline>&lt;/head&gt;</inline>
 <inline>&lt;figDesc&gt;</inline>A Whistleresque view showing four or five sailing boats in the foreground, and a
   series of buoys strung out between them.<inline>&lt;/figDesc&gt;</inline>
                           <inline>&lt;/figure&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;facsimile&gt;</inline>
 <inline>&lt;surfaceGrp n="leaf1"&gt;</inline>
  <inline>&lt;surface&gt;</inline>
   <inline>&lt;graphic url="page1.png"/&gt;</inline>
  <inline>&lt;/surface&gt;</inline>
  <inline>&lt;surface&gt;</inline>
   <inline>&lt;graphic url="page2-highRes.png"/&gt;</inline>
   <inline>&lt;graphic url="page2-lowRes.png"/&gt;</inline>
  <inline>&lt;/surface&gt;</inline>
 <inline>&lt;/surfaceGrp&gt;</inline>
                           <inline>&lt;/facsimile&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
