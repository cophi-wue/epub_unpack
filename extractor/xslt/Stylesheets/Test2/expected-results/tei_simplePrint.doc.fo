                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;keywords&gt;</inline>
 <inline>&lt;term&gt;</inline>Fermented beverages<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Central Andes<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Schinus molle<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Molle beer<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Indigenous peoples<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Ethnography<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Archaeology<inline>&lt;/term&gt;</inline>
                           <inline>&lt;/keywords&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
