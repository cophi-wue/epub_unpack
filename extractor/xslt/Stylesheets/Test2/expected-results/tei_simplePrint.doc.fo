                               space-after.optimum="4pt">
teidata.enumerated = teidata.word</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">Attributes using this datatype must contain a single ‘word’ which contains only letters, digits, punctuation characters, or symbols: thus it cannot include whitespace.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">Typically, the list of documented possibilities will be provided (or exemplified) by a value list in the associated attribute specification, expressed with a <inline hyphenate="false" color="black" font-family="Courier">&lt;valList&gt;</inline> element.</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.teidata.language"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.5.6. teidata.language</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e103359">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">teidata.language</inline> defines the range of attribute values used to identify a particular combination of human language and writing system. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CH.html#CHSH)">6.1. Language Identification</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>tei</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Used by</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>Element: <list-block provisional-distance-between-starts="18pt"
                                       provisional-label-separation="6pt"
                                       text-indent="0em"
                                       margin-right="10pt"
                                       space-before="6pt"
                                       space-after="6pt">
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="end">•</block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <basic-link internal-destination="TEI.language" text-decoration="underline">language</basic-link>/@ident</block>
                                 </list-item-body>
                              </list-item>
                           </list-block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate&gt;
  &lt;dataRef name="language"/&gt;
  &lt;valList&gt;
   &lt;valItem ident=""/&gt;
  &lt;/valList&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Declaration</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
teidata.language = xsd:language | ( "" )</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">The values for this attribute are language ‘tags’ as defined in <basic-link external-destination="url(https://tools.ietf.org/html/bcp47)">BCP 47</basic-link>. Currently BCP 47 comprises RFC 5646 and RFC 4647; over time, other IETF documents may succeed these as the best current practice.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">A ‘language tag’, per BCP 47, is assembled from a sequence of components or <inline font-style="italic" font-weight="normal">subtags</inline> separated by the hyphen character (<inline font-style="italic" font-weight="normal">-</inline>, U+002D). The tag is made of the following subtags, in the following order. Every subtag except the first is optional. If present, each occurs only once, except the fourth and fifth components (variant and extension), which are repeatable. <list-block provisional-distance-between-starts="42pt"
                                       provisional-label-separation="6pt"
                                       text-indent="0em"
                                       margin-right="10pt"
                                       space-before="6pt"
                                       space-after="6pt">
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">language</block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>The IANA-registered code for the language. This is almost always the same as the ISO 639 2-letter language code if there is one. The list of available registered language subtags can be found at <basic-link external-destination="url(http://www.iana.org/assignments/language-subtag-registry)">http://www.iana.org/assignments/language-subtag-registry</basic-link>. It is recommended that this code be written in lower case.</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">script</block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>The ISO 15924 code for the script. These codes consist of 4 letters, and it is recommended they be written with an initial capital, the other three letters in lower case. The canonical list of codes is maintained by the Unicode Consortium, and is available at <basic-link external-destination="url(http://unicode.org/iso15924/iso15924-codes.html)">http://unicode.org/iso15924/iso15924-codes.html</basic-link>. The IETF recommends this code be omitted unless it is necessary to make a distinction you need.</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">region</block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>Either an ISO 3166 country code or a UN M.49 region code that is registered with IANA (not all such codes are registered, e.g. UN codes for economic groupings or codes for countries for which there is already an ISO 3166 2-letter code are not registered). The former consist of 2 letters, and it is recommended they be written in upper case; the list of codes can be searched or browsed at <basic-link external-destination="url(https://www.iso.org/obp/ui/#search/code/)">https://www.iso.org/obp/ui/#search/code/</basic-link>. The latter consist of 3 digits; the list of codes can be found at <basic-link external-destination="url(http://unstats.un.org/unsd/methods/m49/m49.htm)">http://unstats.un.org/unsd/methods/m49/m49.htm</basic-link>.</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">variant</block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>An IANA-registered variation. These codes are used to indicate additional, well-recognized variations that define a language or its dialects that are not covered by other available subtags.</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">extension</block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>An extension has the format of a single letter followed by a hyphen followed by additional subtags. These exist to allow for future extension to BCP 47, but as of this writing no such extensions are in use.</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">private use</block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>An extension that uses the initial subtag of the single letter <inline font-style="italic" font-weight="normal">x</inline> (i.e., starts with <inline font-family="Courier">x-</inline>) has no meaning except as negotiated among the parties involved. These should be used with great care, since they interfere with the interoperability that use of RFC 4646 is intended to promote. In order for a document that makes use of these subtags to be TEI-conformant, a corresponding <basic-link internal-destination="TEI.language" text-decoration="underline">&lt;language&gt;</basic-link> element must be present in the TEI header.</block>
                                 </list-item-body>
                              </list-item>
                           </list-block>
                        </block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">There are two exceptions to the above format. First, there are language tags in the <basic-link external-destination="url(http://www.iana.org/assignments/language-subtag-registry)">IANA registry</basic-link> that do not match the above syntax, but are present because they have been ‘grandfathered’ from previous specifications.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">Second, an entire language tag can consist of only a private use subtag. These tags start with <inline font-family="Courier">x-</inline>, and do not need to follow any further rules established by the IETF and endorsed by these Guidelines. Like all language tags that make use of private use subtags, the language in question must be documented in a corresponding <basic-link internal-destination="TEI.language" text-decoration="underline">&lt;language&gt;</basic-link> element in the TEI header.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">Examples include <list-block provisional-distance-between-starts="42pt"
                                       provisional-label-separation="6pt"
                                       text-indent="0em"
                                       margin-right="10pt"
                                       space-before="6pt"
                                       space-after="6pt">
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">
                                       <inline>sn</inline>
                                    </block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>Shona</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">
                                       <inline>zh-TW</inline>
                                    </block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>Taiwanese</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">
                                       <inline>zh-Hant-HK</inline>
                                    </block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>Chinese written in traditional script as used in Hong Kong</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">
                                       <inline>en-SL</inline>
                                    </block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>English as spoken in Sierra Leone</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">
                                       <inline>pl</inline>
                                    </block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>Polish</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">
                                       <inline>es-MX</inline>
                                    </block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>Spanish as spoken in Mexico</block>
                                 </list-item-body>
                              </list-item>
                              <list-item space-before.optimum="4pt">
                                 <list-item-label end-indent="label-end()">
                                    <block text-align="start"
                                           font-weight="bold"
                                           keep-together.within-line="always">
                                       <inline>es-419</inline>
                                    </block>
                                 </list-item-label>
                                 <list-item-body start-indent="body-start()">
                                    <block font-weight="normal">
                                       <block> </block>Spanish as spoken in Latin America</block>
                                 </list-item-body>
                              </list-item>
                           </list-block>
                        </block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">The W3C Internationalization Activity has published a useful introduction to BCP 47, <basic-link external-destination="url(http://www.w3.org/International/articles/language-tags/Overview.en.php)">Language tags in HTML and XML</basic-link>.</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
