                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.temporal.w3c"
                                                                  text-decoration="underline">teidata.temporal.w3c</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">For simple dates, the <inline font-style="italic">when</inline> attribute should give the Gregorian or proleptic Gregorian date in one of the formats specified in <inline font-style="italic">XML Schema Part 2: Datatypes Second Edition</inline>. </block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
