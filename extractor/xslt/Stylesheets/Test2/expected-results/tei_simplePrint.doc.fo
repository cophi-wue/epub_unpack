                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;sch:assert test="count(descendant::tei:lg|descendant::tei:l|descendant::tei:gap) &gt; 
 0"&gt;An lg element
 must contain at least one child l, lg or gap element.&lt;/sch:assert&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
