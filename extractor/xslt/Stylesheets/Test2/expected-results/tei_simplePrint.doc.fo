                               space-after.optimum="4pt">
                           <inline>&lt;char xml:id="circledU4EBA"&gt;</inline>
 <inline>&lt;charName&gt;</inline>CIRCLED IDEOGRAPH 4EBA<inline>&lt;/charName&gt;</inline>
 <inline>&lt;charProp&gt;</inline>
  <inline>&lt;unicodeName&gt;</inline>character-decomposition-mapping<inline>&lt;/unicodeName&gt;</inline>
