                               space-after.optimum="4pt">
                           <inline>&lt;person xml:id="Stevenson" sex="m"
 role="writer"&gt;</inline>
 <inline>&lt;p&gt;</inline>
  <inline>&lt;name type="surname"&gt;</inline>Stevenson<inline>&lt;/name&gt;</inline>
  <inline>&lt;name type="forename"&gt;</inline>Robert<inline>&lt;/name&gt;</inline>
  <inline>&lt;name type="forename"&gt;</inline>Louis<inline>&lt;/name&gt;</inline>
 <inline>&lt;/p&gt;</inline>
