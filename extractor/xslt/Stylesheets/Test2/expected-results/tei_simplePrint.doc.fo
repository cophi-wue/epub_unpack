                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element stage
{
   att.ascribed.attributes,
   att.global.attributes,
   att.placement.attributes,
   attribute type
   {
      list
      {
         (
            "setting"
          | "entrance"
          | "exit"
          | "business"
          | "novelistic"
          | "delivery"
          | "modifier"
          | "location"
          | "mixed"
         )*
      }
   }?,
   macro.specialPara
}</block>
