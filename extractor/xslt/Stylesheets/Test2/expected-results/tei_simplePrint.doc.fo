                                 <inline font-weight="bold">header: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.change" text-decoration="underline">change</basic-link>
                                    <basic-link internal-destination="TEI.distributor" text-decoration="underline">distributor</basic-link>
                                    <basic-link internal-destination="TEI.edition" text-decoration="underline">edition</basic-link>
                                    <basic-link internal-destination="TEI.extent" text-decoration="underline">extent</basic-link>
                                    <basic-link internal-destination="TEI.idno" text-decoration="underline">idno</basic-link>
                                    <basic-link internal-destination="TEI.licence" text-decoration="underline">licence</basic-link>
                                 </inline>
                              </block>
                              <block>
                                 <inline font-weight="bold">linking: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.ab" text-decoration="underline">ab</basic-link>
                                    <basic-link internal-destination="TEI.seg" text-decoration="underline">seg</basic-link>
                                 </inline>
                              </block>
                              <block>
                                 <inline font-weight="bold">textstructure: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.byline" text-decoration="underline">byline</basic-link>
                                    <basic-link internal-destination="TEI.closer" text-decoration="underline">closer</basic-link>
                                    <basic-link internal-destination="TEI.dateline" text-decoration="underline">dateline</basic-link>
                                    <basic-link internal-destination="TEI.docAuthor" text-decoration="underline">docAuthor</basic-link>
                                    <basic-link internal-destination="TEI.docDate" text-decoration="underline">docDate</basic-link>
                                    <basic-link internal-destination="TEI.docEdition" text-decoration="underline">docEdition</basic-link>
                                    <basic-link internal-destination="TEI.docImprint" text-decoration="underline">docImprint</basic-link>
                                    <basic-link internal-destination="TEI.imprimatur" text-decoration="underline">imprimatur</basic-link>
                                    <basic-link internal-destination="TEI.opener" text-decoration="underline">opener</basic-link>
                                    <basic-link internal-destination="TEI.salute" text-decoration="underline">salute</basic-link>
                                    <basic-link internal-destination="TEI.signed" text-decoration="underline">signed</basic-link>
                                    <basic-link internal-destination="TEI.titlePart" text-decoration="underline">titlePart</basic-link>
                                    <basic-link internal-destination="TEI.trailer" text-decoration="underline">trailer</basic-link>
                                 </inline>
                              </block>
                              <block>
                                 <inline font-weight="bold">transcr: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link>
                                    <basic-link internal-destination="TEI.supplied" text-decoration="underline">supplied</basic-link>
                                 </inline>
                              </block>
                              <block>
                                 <inline font-weight="bold">verse: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.rhyme" text-decoration="underline">rhyme</basic-link>
                                 </inline>
                              </block>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">May contain</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Character data only</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">The name <inline color="black" font-family="Helvetica">g</inline> is short for <inline font-style="italic" font-weight="normal">gaiji</inline>, which is the Japanese term for a non-standardized character or glyph.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;g ref="#ctlig"&gt;</inline>ct<inline>&lt;/g&gt;</inline>
                        </block>This example points to a <basic-link internal-destination="TEI.glyph" text-decoration="underline">&lt;glyph&gt;</basic-link> element with the identifier <inline font-family="Courier">ctlig</inline> like the following: <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;glyph xml:id="ctlig"&gt;</inline>
                           <inline>&lt;!-- here we describe the particular ct-ligature intended --&gt;</inline>
                           <inline>&lt;/glyph&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;g ref="#per-glyph"&gt;</inline>per<inline>&lt;/g&gt;</inline>
                        </block>The medieval brevigraph per could similarly be considered as an individual glyph, defined in a <basic-link internal-destination="TEI.glyph" text-decoration="underline">&lt;glyph&gt;</basic-link> element with the identifier <inline font-family="Courier">per</inline> like the following: <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;glyph xml:id="per-glyph"&gt;</inline>
                           <inline>&lt;!-- ... --&gt;</inline>
                           <inline>&lt;/glyph&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;textNode/&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schema Declaration</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element g
{
   att.global.attributes,
   att.typed.attributes,
   attribute ref { text }?,
   text
}</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Processing Model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;model predicate="not(text())"
 behaviour="glyph"&gt;
&lt;param name="uri" value="@ref"/&gt;
&lt;/model&gt;
&lt;model behaviour="inline"/&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.gap"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.70. &lt;gap&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e38121">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;gap&gt; </inline>indicates a point where material has been omitted in a transcription, whether for editorial reasons described in the TEI header, as part of sampling practice, or because the material is illegible, invisible, or inaudible. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDADD)">3.4.3. Additions, Deletions, and Omissions</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>core</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>)) <basic-link internal-destination="TEI.att.timed" text-decoration="underline">att.timed</basic-link> (<inline>@start</inline>, <inline>@end</inline>) <basic-link internal-destination="TEI.att.editLike" text-decoration="underline">att.editLike</basic-link> (<basic-link internal-destination="TEI.att.dimensions" text-decoration="underline">att.dimensions</basic-link> (<inline>@unit</inline>, <inline>@quantity</inline>, <inline>@extent</inline>, <inline>@scope</inline>)) <table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e38245">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>reason</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>gives the reason for omission. Sample values include <inline>sampling</inline>, <inline>inaudible</inline>, <inline>irrelevant</inline>, <inline>cancelled</inline>.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e38267">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.word" text-decoration="underline">teidata.word</basic-link> separated by whitespace</block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>agent</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>in the case of text omitted because of damage, categorizes the cause of the damage, if it can be identified.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e38297">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.enumerated"
                                                                  text-decoration="underline">teidata.enumerated</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Sample values include:</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <list-block provisional-distance-between-starts="18pt"
                                                                  provisional-label-separation="6pt"
                                                                  text-indent="0em"
                                                                  margin-right="10pt"
                                                                  space-before="6pt"
                                                                  space-after="6pt">
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">rubbing</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>damage results from rubbing of the leaf edges</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">mildew</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>damage results from mildew on the leaf surface</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">smoke</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>damage results from smoke</block>
                                                            </list-item-body>
                                                         </list-item>
                                                      </list-block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Member of</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <basic-link internal-destination="TEI.model.global.edit"
                                       text-decoration="underline">model.global.edit</basic-link>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Contained by</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <block>
                                 <inline font-weight="bold">analysis: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.s" text-decoration="underline">s</basic-link>
                                    <basic-link internal-destination="TEI.w" text-decoration="underline">w</basic-link>
                                 </inline>
                              </block>
                              <block>
                                 <inline font-weight="bold">core: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.abbr" text-decoration="underline">abbr</basic-link>
                                    <basic-link internal-destination="TEI.add" text-decoration="underline">add</basic-link>
                                    <basic-link internal-destination="TEI.addrLine" text-decoration="underline">addrLine</basic-link>
                                    <basic-link internal-destination="TEI.address" text-decoration="underline">address</basic-link>
                                    <basic-link internal-destination="TEI.author" text-decoration="underline">author</basic-link>
                                    <basic-link internal-destination="TEI.bibl" text-decoration="underline">bibl</basic-link>
                                    <basic-link internal-destination="TEI.biblScope" text-decoration="underline">biblScope</basic-link>
                                    <basic-link internal-destination="TEI.cit" text-decoration="underline">cit</basic-link>
                                    <basic-link internal-destination="TEI.corr" text-decoration="underline">corr</basic-link>
                                    <basic-link internal-destination="TEI.date" text-decoration="underline">date</basic-link>
                                    <basic-link internal-destination="TEI.del" text-decoration="underline">del</basic-link>
                                    <basic-link internal-destination="TEI.editor" text-decoration="underline">editor</basic-link>
