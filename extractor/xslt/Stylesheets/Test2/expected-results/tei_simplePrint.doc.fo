                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">May contain</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Empty element</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">A <basic-link internal-destination="TEI.pb" text-decoration="underline">&lt;pb&gt;</basic-link> element should appear at the start of the page which it identifies. The global <inline font-style="italic">n</inline> attribute indicates the number or other value associated with this page. This will normally be the page number or signature printed on it, since the physical sequence number is implicit in the presence of the <basic-link internal-destination="TEI.pb" text-decoration="underline">&lt;pb&gt;</basic-link> element itself.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">The <inline font-style="italic">type</inline> attribute may be used to characterize the page break in any respect. The more specialized attributes <inline font-style="italic">break</inline>, <inline font-style="italic">ed</inline>, or <inline font-style="italic">edRef</inline> should be preferred when the intent is to indicate whether or not the page break is word-breaking, or to note the source from which it derives.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Page numbers may vary in different editions of a text.<block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;p&gt;</inline> ... <inline>&lt;pb n="145" ed="ed2"/&gt;</inline>
                           <inline>&lt;!-- Page 145 in edition "ed2" starts here --&gt;</inline> ... <inline>&lt;pb n="283" ed="ed1"/&gt;</inline>
                           <inline>&lt;!-- Page 283 in edition "ed1" starts here--&gt;</inline> ... <inline>&lt;/p&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>A page break may be associated with a facsimile image of the page it introduces by means of the <inline font-style="italic">facs</inline> attribute<block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;body&gt;</inline>
 <inline>&lt;pb n="1" facs="page1.png"/&gt;</inline>
                           <inline>&lt;!-- page1.png contains an image of the page;
                        the text it contains is encoded here --&gt;</inline>
 <inline>&lt;p&gt;</inline>
                           <inline>&lt;!-- ... --&gt;</inline>
 <inline>&lt;/p&gt;</inline>
 <inline>&lt;pb n="2" facs="page2.png"/&gt;</inline>
                           <inline>&lt;!-- similarly, for page 2 --&gt;</inline>
 <inline>&lt;p&gt;</inline>
                           <inline>&lt;!-- ... --&gt;</inline>
 <inline>&lt;/p&gt;</inline>
                           <inline>&lt;/body&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;s:report test="parent::*/text() and not (preceding-sibling::text() and following-sibling::text())"&gt;please make sure pb elements are not at the start or end of mixed content
&lt;/s:report&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content/&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schema Declaration</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element pb
{
   att.global.attributes,
   att.typed.attributes,
   att.edition.attributes,
   att.spanning.attributes,
   att.breaking.attributes,
   empty
}</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Processing Model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;model behaviour="break"
 useSourceRendition="true"&gt;
&lt;param name="type" value="'page'"/&gt;
&lt;param name="label"
 value="(concat(if(@n) then concat(@n,' ') else '',if(@facs) then concat('@',@facs) 
 else ''))"/&gt;
&lt;outputRendition&gt; display: block; margin-left: 4pt; color: grey; float: right; &lt;/outputRendition&gt;
&lt;outputRendition scope="before"&gt;content: '[Page ';&lt;/outputRendition&gt;
&lt;outputRendition scope="after"&gt;content: ']';&lt;/outputRendition&gt;
&lt;/model&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.pc"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.107. &lt;pc&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e57453">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;pc&gt; </inline>(punctuation character) contains a character or string of characters regarded as constituting a single punctuation mark. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/AI.html#AILC)">17.1. Linguistic Segment Categories</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>analysis</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>)) <basic-link internal-destination="TEI.att.segLike" text-decoration="underline">att.segLike</basic-link> (<inline>@function</inline>)  (<basic-link internal-destination="TEI.att.fragmentable" text-decoration="underline">att.fragmentable</basic-link> (<inline>@part</inline>)) <basic-link internal-destination="TEI.att.typed" text-decoration="underline">att.typed</basic-link> (<inline>@type</inline>, <inline>@subtype</inline>) <table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e57578">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>force</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates the extent to which this punctuation mark conventionally separates words or phrases<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e57588">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.enumerated"
                                                                  text-decoration="underline">teidata.enumerated</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Legal values are:</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <list-block provisional-distance-between-starts="18pt"
                                                                  provisional-label-separation="6pt"
                                                                  text-indent="0em"
                                                                  margin-right="10pt"
                                                                  space-before="6pt"
                                                                  space-after="6pt">
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">strong</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the punctuation mark is a word separator</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">weak</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the punctuation mark is not a word separator</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">inter</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>the punctuation mark may or may not be a word separator</block>
                                                            </list-item-body>
                                                         </list-item>
                                                      </list-block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>unit</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>provides a name for the kind of unit delimited by this punctuation mark.<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e57632">
                                          <table-column column-number="1" column-width="20%"/>
