                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.90. &lt;listChange&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e48478">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;listChange&gt; </inline>groups a number of change descriptions associated with either the creation of a source text or the revision of an encoded text. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD6)">2.6. The Revision Description</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PH-changes)">11.7. Identifying Changes and Revisions</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>header</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>)) <basic-link internal-destination="TEI.att.sortable" text-decoration="underline">att.sortable</basic-link> (<inline>@sortKey</inline>) <basic-link internal-destination="TEI.att.typed" text-decoration="underline">att.typed</basic-link> (<inline>@type</inline>, <inline>@subtype</inline>) <table text-align="left"
                               font-size="9pt"
                               table-layout="fixed"
                               width="100%"
                               id="d27e48594">
                           <table-column column-number="1" column-width="20%"/>
                           <table-column column-number="2" column-width="80%"/>
                           <table-body text-indent="0pt">
                              <table-row>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>ordered</block>
                                 </table-cell>
                                 <table-cell padding="2pt" text-align="left">
                                    <block>indicates whether the ordering of its child <basic-link internal-destination="TEI.change" text-decoration="underline">&lt;change&gt;</basic-link> elements is to be considered significant or not<table text-align="left"
                                              font-size="9pt"
                                              table-layout="fixed"
                                              width="100%"
                                              id="d27e48607">
                                          <table-column column-number="1" column-width="20%"/>
                                          <table-column column-number="2" column-width="80%"/>
                                          <table-body text-indent="0pt">
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Status</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>Optional</block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Datatype</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <basic-link internal-destination="TEI.teidata.truthValue"
                                                                  text-decoration="underline">teidata.truthValue</basic-link>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Default</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>true</block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Contained by</inline>
                     </block>
                  </table-cell>
