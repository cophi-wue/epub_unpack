                                 <basic-link internal-destination="TEI.closer" text-decoration="underline">closer</basic-link>
                                 <basic-link internal-destination="TEI.dateline" text-decoration="underline">dateline</basic-link>
                                 <basic-link internal-destination="TEI.div" text-decoration="underline">div</basic-link>
                                 <basic-link internal-destination="TEI.docAuthor" text-decoration="underline">docAuthor</basic-link>
