                     <block>
                        <block>
                           <block>
                              <inline font-weight="bold">gaiji: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.g" text-decoration="underline">g</basic-link>
                              </inline>
                           </block>
                           <block>character data</block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">Suggested values for the <inline font-style="italic">type</inline> attribute include <inline font-family="Courier">exact</inline> for exact equivalences, <inline font-family="Courier">uppercase</inline> for uppercase equivalences, <inline font-family="Courier">lowercase</inline> for lowercase equivalences, and <inline font-family="Courier">simplified</inline> for simplified characters. The <basic-link internal-destination="TEI.g" text-decoration="underline">&lt;g&gt;</basic-link> elements contained by this element can point to either another <basic-link internal-destination="TEI.char" text-decoration="underline">&lt;char&gt;</basic-link> or <basic-link internal-destination="TEI.glyph" text-decoration="underline">&lt;glyph&gt;</basic-link>element or contain a character that is intended to be the target of this mapping.</block>
                     </block>
                  </table-cell>
               </table-row>
