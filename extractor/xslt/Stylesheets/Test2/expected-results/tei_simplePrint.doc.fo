&lt;model behaviour="inline"
 predicate="not(@target)"/&gt;
&lt;model predicate="not(text())"
 behaviour="link"&gt;
&lt;param name="content" value="@target"/&gt;
&lt;param name="uri" value="@target"/&gt;
&lt;/model&gt;
