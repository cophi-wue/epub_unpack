                     <block>
                        <block>
                           <block>
                              <inline font-weight="bold">core: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.p" text-decoration="underline">p</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">linking: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.ab" text-decoration="underline">ab</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">namesdates: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.listPlace" text-decoration="underline">listPlace</basic-link>
                                 <basic-link internal-destination="TEI.place" text-decoration="underline">place</basic-link>
                              </inline>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">May contain a prose description organized as paragraphs, or a series of <inline hyphenate="false" color="black" font-family="Courier">&lt;setting&gt;</inline> elements. If used to record not settings of language interactions, but other places mentioned in the text, then <basic-link internal-destination="TEI.place" text-decoration="underline">&lt;place&gt;</basic-link> optionally grouped by <basic-link internal-destination="TEI.listPlace" text-decoration="underline">&lt;listPlace&gt;</basic-link> should be preferred.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;settingDesc&gt;</inline>
 <inline>&lt;p&gt;</inline>Texts recorded in the
   Canadian Parliament building in Ottawa, between April and November 1988 <inline>&lt;/p&gt;</inline>
