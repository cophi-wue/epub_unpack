                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;respStmt&gt;</inline>
 <inline>&lt;resp ref="http://id.loc.gov/vocabulary/relators/com.html"&gt;</inline>compiler<inline>&lt;/resp&gt;</inline>
 <inline>&lt;name&gt;</inline>Edward Child<inline>&lt;/name&gt;</inline>
                           <inline>&lt;/respStmt&gt;</inline>
                        </block>
