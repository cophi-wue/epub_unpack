                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
teidata.word = token { pattern = "(\p{L}|\p{N}|\p{P}|\p{S})+" }</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">Attributes using this datatype must contain a single ‘word’ which contains only letters, digits, punctuation characters, or symbols: thus it cannot include whitespace.</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="d27e104621"
                text-align="left"
                font-family="Times"
                font-size="14pt"
                font-weight="bold"
                space-after="3pt"
                space-before.optimum="9pt"
                text-indent="0em">17.6. Summary of changes</block>
         <block line-height="1">The TEI simplePrint schema uses the TEI infrastructure and gaiji modules unchanged. </block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e104624">
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell padding="2pt" text-align="left">
                     <block>Module tei</block>
                  </table-cell>
                  <table-cell padding="2pt" text-align="left">
                     <block/>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell padding="2pt" text-align="left">
                     <block>Module gaiji</block>
                  </table-cell>
                  <table-cell padding="2pt" text-align="left">
                     <block/>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block line-height="1"
                text-indent="1em"
                space-before.optimum="0pt"
                space-before.maximum="12pt">A subset of 45 elements is selected from the TEI header module. In addition, elements <basic-link internal-destination="TEI.particDesc" text-decoration="underline">&lt;particDesc&gt;</basic-link> and <basic-link internal-destination="TEI.settingDesc" text-decoration="underline">&lt;settingDesc&gt;</basic-link> are provided from the corpus module. The class membership of <basic-link internal-destination="TEI.particDesc" text-decoration="underline">&lt;particDesc&gt;</basic-link> is changed to ensure that it can only appear inside <basic-link internal-destination="TEI.profileDesc" text-decoration="underline">&lt;profileDesc&gt;</basic-link>. Secondly, a Schematron rule is added to the <basic-link internal-destination="TEI.text" text-decoration="underline">&lt;text&gt;</basic-link> element to ensure that elements <basic-link internal-destination="TEI.term" text-decoration="underline">&lt;term&gt;</basic-link> and <basic-link internal-destination="TEI.biblFull" text-decoration="underline">&lt;biblFull&gt;</basic-link> can appear only in the header element, even though the schema permits them additionally in text.</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e104655">
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell padding="2pt" text-align="left">
                     <block>Module header</block>
                  </table-cell>
                  <table-cell padding="2pt" text-align="left">
                     <block/>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell padding="2pt" text-align="left">
                     <block>Module corpus</block>
                  </table-cell>
                  <table-cell padding="2pt" text-align="left">
                     <block/>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
