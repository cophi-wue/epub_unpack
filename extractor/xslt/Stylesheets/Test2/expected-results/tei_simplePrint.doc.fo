                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">The <inline font-style="italic">who</inline> attribute may be used to indicate more precisely the person or persons participating in the action described by the stage direction.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;stage type="setting"&gt;</inline>A curtain being drawn.<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;stage type="setting"&gt;</inline>Music<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;stage type="entrance"&gt;</inline>Enter Husband as being thrown off his horse and falls.<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;!-- Middleton : Yorkshire Tragedy --&gt;</inline>
                           <inline>&lt;stage type="exit"&gt;</inline>Exit pursued by a bear.<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;stage type="business"&gt;</inline>He quickly takes the stone out.<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;stage type="delivery"&gt;</inline>To Lussurioso.<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;stage type="novelistic"&gt;</inline>Having had enough, and embarrassed for the family.<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;!-- Lorraine Hansbury : a raisin in in the sun --&gt;</inline>
                           <inline>&lt;stage type="modifier"&gt;</inline>Disguised as Ansaldo.<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;stage type="entrance modifier"&gt;</inline>Enter Latrocinio disguised as an empiric<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;!-- Middleton: The Widow --&gt;</inline>
                           <inline>&lt;stage type="location"&gt;</inline>At a window.<inline>&lt;/stage&gt;</inline>
                           <inline>&lt;stage rend="inline" type="delivery"&gt;</inline>Aside.<inline>&lt;/stage&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;l&gt;</inline>Behold. <inline>&lt;stage n="*" place="margin"&gt;</inline>Here the vp<inline>&lt;lb/&gt;</inline>per part of the <inline>&lt;hi&gt;</inline>Scene<inline>&lt;/hi&gt;</inline> open'd; when
   straight appear'd a Heauen, and all the <inline>&lt;hi&gt;</inline>Pure Artes<inline>&lt;/hi&gt;</inline> sitting on
   two semi<inline>&lt;lb/&gt;</inline>circular ben<inline>&lt;lb/&gt;</inline>ches, one a<inline>&lt;lb/&gt;</inline>boue another: who sate thus till the rest of the
 <inline>&lt;hi&gt;</inline>Prologue<inline>&lt;/hi&gt;</inline> was spoken, which being ended, they descended in
   order within the <inline>&lt;hi&gt;</inline>Scene,<inline>&lt;/hi&gt;</inline> whiles the Musicke plaid<inline>&lt;/stage&gt;</inline> Our
 Poet knowing our free hearts<inline>&lt;/l&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
