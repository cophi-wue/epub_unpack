                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;p&gt;</inline>I reached <inline>&lt;num type="cardinal" value="21"&gt;</inline>twenty-one<inline>&lt;/num&gt;</inline> on
 my <inline>&lt;num type="ordinal" value="21"&gt;</inline>twenty-first<inline>&lt;/num&gt;</inline> birthday<inline>&lt;/p&gt;</inline>
                           <inline>&lt;p&gt;</inline>Light travels at <inline>&lt;num value="3E10"&gt;</inline>3×10<inline>&lt;hi rend="sup"&gt;</inline>10<inline>&lt;/hi&gt;</inline>
 <inline>&lt;/num&gt;</inline> cm per second.<inline>&lt;/p&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
