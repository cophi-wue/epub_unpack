                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="0"
  maxOccurs="unbounded"&gt;
  &lt;textNode/&gt;
  &lt;classRef key="model.gLike"/&gt;
  &lt;elementRef key="idno"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block>
