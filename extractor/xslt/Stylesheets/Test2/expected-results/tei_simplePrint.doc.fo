                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;model predicate="child::quote and child::bibl"
 behaviour="cit"&gt;
&lt;desc&gt;Insert citation &lt;/desc&gt;
&lt;/model&gt;
    </block>
