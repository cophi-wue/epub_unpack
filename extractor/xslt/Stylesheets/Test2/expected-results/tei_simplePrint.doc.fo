                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>)) <basic-link internal-destination="TEI.att.typed" text-decoration="underline">att.typed</basic-link> (<inline>@type</inline>, <inline>@subtype</inline>) <basic-link internal-destination="TEI.att.written" text-decoration="underline">att.written</basic-link> (<inline>@hand</inline>) </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Member of</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <basic-link internal-destination="TEI.model.resourceLike"
                                       text-decoration="underline">model.resourceLike</basic-link>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Contained by</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <block>
                                 <inline font-weight="bold">core: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.teiCorpus" text-decoration="underline">teiCorpus</basic-link>
                                 </inline>
                              </block>
                              <block>
                                 <inline font-weight="bold">textstructure: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.TEI" text-decoration="underline">TEI</basic-link>
                                    <basic-link internal-destination="TEI.group" text-decoration="underline">group</basic-link>
                                 </inline>
                              </block>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">May contain</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <inline font-weight="bold">core: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.cb" text-decoration="underline">cb</basic-link>
                                 <basic-link internal-destination="TEI.gap" text-decoration="underline">gap</basic-link>
                                 <basic-link internal-destination="TEI.lb" text-decoration="underline">lb</basic-link>
                                 <basic-link internal-destination="TEI.milestone" text-decoration="underline">milestone</basic-link>
                                 <basic-link internal-destination="TEI.note" text-decoration="underline">note</basic-link>
                                 <basic-link internal-destination="TEI.pb" text-decoration="underline">pb</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">figures: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.figure" text-decoration="underline">figure</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">linking: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.anchor" text-decoration="underline">anchor</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">textstructure: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.back" text-decoration="underline">back</basic-link>
                                 <basic-link internal-destination="TEI.body" text-decoration="underline">body</basic-link>
                                 <basic-link internal-destination="TEI.front" text-decoration="underline">front</basic-link>
                                 <basic-link internal-destination="TEI.group" text-decoration="underline">group</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">transcr: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link>
                              </inline>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">This element should not be used to represent a text which is inserted at an arbitrary point within the structure of another, for example as in an embedded or quoted narrative; the <basic-link internal-destination="TEI.floatingText" text-decoration="underline">&lt;floatingText&gt;</basic-link> is provided for this purpose.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;text&gt;</inline>
 <inline>&lt;front&gt;</inline>
  <inline>&lt;docTitle&gt;</inline>
   <inline>&lt;titlePart&gt;</inline>Autumn Haze<inline>&lt;/titlePart&gt;</inline>
  <inline>&lt;/docTitle&gt;</inline>
 <inline>&lt;/front&gt;</inline>
 <inline>&lt;body&gt;</inline>
  <inline>&lt;l&gt;</inline>Is it a dragonfly or a maple leaf<inline>&lt;/l&gt;</inline>
  <inline>&lt;l&gt;</inline>That settles softly down upon the water?<inline>&lt;/l&gt;</inline>
 <inline>&lt;/body&gt;</inline>
                           <inline>&lt;/text&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>The body of a text may be replaced by a group of nested texts, as in the following schematic:<block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;text&gt;</inline>
 <inline>&lt;front&gt;</inline>
                           <inline>&lt;!-- front matter for the whole group --&gt;</inline>
 <inline>&lt;/front&gt;</inline>
 <inline>&lt;group&gt;</inline>
  <inline>&lt;text&gt;</inline>
                           <inline>&lt;!-- first text --&gt;</inline>
  <inline>&lt;/text&gt;</inline>
  <inline>&lt;text&gt;</inline>
                           <inline>&lt;!-- second text --&gt;</inline>
  <inline>&lt;/text&gt;</inline>
 <inline>&lt;/group&gt;</inline>
                           <inline>&lt;/text&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;s:rule context="tei:term | tei:biblFull "&gt;
&lt;s:report test="ancestor::tei:text"&gt;Error: The element &lt;s:name/&gt; is not permitted
 outside the header&lt;/s:report&gt;
&lt;/s:rule&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence minOccurs="1" maxOccurs="1"&gt;
  &lt;classRef key="model.global"
   minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;sequence minOccurs="0" maxOccurs="1"&gt;
   &lt;elementRef key="front"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
  &lt;alternate minOccurs="1" maxOccurs="1"&gt;
   &lt;elementRef key="body"/&gt;
   &lt;elementRef key="group"/&gt;
  &lt;/alternate&gt;
  &lt;classRef key="model.global"
   minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;sequence minOccurs="0" maxOccurs="1"&gt;
   &lt;elementRef key="back"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schema Declaration</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element text
{
   att.global.attributes,
   att.typed.attributes,
   att.written.attributes,
   (
      model.global*,
      ( front, model.global* )?,
      ( body | group ),
      model.global*,
      ( back, model.global* )?
   )
}</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Processing Model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;model behaviour="body"&gt;
&lt;outputRendition&gt; max-width: 80%; margin: auto; font-family: Verdana, Tahoma,
 Geneva, Arial, Helvetica, sans-serif; &lt;/outputRendition&gt;
&lt;/model&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.textClass"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.156. &lt;textClass&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e79745">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;textClass&gt; </inline>(text classification) groups information which describes the nature or topic of a text in terms of a standard classification scheme, thesaurus, etc. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD43)">2.4.3. The Text Classification</basic-link>]</block>
