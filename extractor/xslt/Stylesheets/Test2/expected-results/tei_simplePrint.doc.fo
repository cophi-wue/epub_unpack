         <block keep-with-next.within-page="always"
                id="TEI.taxonomy"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.151. &lt;taxonomy&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e77867">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;taxonomy&gt; </inline>defines a typology either implicitly, by means of a bibliographic citation, or explicitly by a structured taxonomy. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD55)">2.3.7. The Classification Declaration</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>header</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
                                    text-decoration="underline">att.global.rendition</basic-link> (<inline>@rendition</inline>)) (<basic-link internal-destination="TEI.att.global.linking"
                                    text-decoration="underline">att.global.linking</basic-link> (<inline>@corresp</inline>, <inline>@next</inline>, <inline>@prev</inline>)) (<basic-link internal-destination="TEI.att.global.analytic"
                                    text-decoration="underline">att.global.analytic</basic-link> (<inline>@ana</inline>)) (<basic-link internal-destination="TEI.att.global.facs" text-decoration="underline">att.global.facs</basic-link> (<inline>@facs</inline>)) (<basic-link internal-destination="TEI.att.global.responsibility"
                                    text-decoration="underline">att.global.responsibility</basic-link> (<inline>@cert</inline>, <inline>@resp</inline>)) (<basic-link internal-destination="TEI.att.global.source"
                                    text-decoration="underline">att.global.source</basic-link> (<inline>@source</inline>))</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Contained by</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <block>
                                 <inline font-weight="bold">header: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.classDecl" text-decoration="underline">classDecl</basic-link>
                                    <basic-link internal-destination="TEI.taxonomy" text-decoration="underline">taxonomy</basic-link>
                                 </inline>
                              </block>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">May contain</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <inline font-weight="bold">core: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.bibl" text-decoration="underline">bibl</basic-link>
                                 <basic-link internal-destination="TEI.desc" text-decoration="underline">desc</basic-link>
                                 <basic-link internal-destination="TEI.listBibl" text-decoration="underline">listBibl</basic-link>
                              </inline>
                           </block>
                           <block>
                              <inline font-weight="bold">header: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.biblFull" text-decoration="underline">biblFull</basic-link>
                                 <basic-link internal-destination="TEI.category" text-decoration="underline">category</basic-link>
                                 <basic-link internal-destination="TEI.taxonomy" text-decoration="underline">taxonomy</basic-link>
                              </inline>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">Nested taxonomies are common in many fields, so the <basic-link internal-destination="TEI.taxonomy" text-decoration="underline">&lt;taxonomy&gt;</basic-link> element can be nested.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;classDecl&gt;</inline>
 <inline>&lt;taxonomy xml:id="OTASH"&gt;</inline>
  <inline>&lt;bibl&gt;</inline>University of Oxford Text Archive Subject Headings<inline>&lt;/bibl&gt;</inline>
 <inline>&lt;/taxonomy&gt;</inline>
                           <inline>&lt;/classDecl&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;taxonomy&gt;</inline>
 <inline>&lt;category xml:id="literature"&gt;</inline>
  <inline>&lt;catDesc&gt;</inline>Literature<inline>&lt;/catDesc&gt;</inline>
  <inline>&lt;category xml:id="poetry"&gt;</inline>
   <inline>&lt;catDesc&gt;</inline>Poetry<inline>&lt;/catDesc&gt;</inline>
   <inline>&lt;category xml:id="sonnet"&gt;</inline>
    <inline>&lt;catDesc&gt;</inline>Sonnet<inline>&lt;/catDesc&gt;</inline>
    <inline>&lt;category xml:id="shakesSonnet"&gt;</inline>
     <inline>&lt;catDesc&gt;</inline>Shakespearean Sonnet<inline>&lt;/catDesc&gt;</inline>
    <inline>&lt;/category&gt;</inline>
    <inline>&lt;category xml:id="petraSonnet"&gt;</inline>
     <inline>&lt;catDesc&gt;</inline>Petrarchan Sonnet<inline>&lt;/catDesc&gt;</inline>
    <inline>&lt;/category&gt;</inline>
   <inline>&lt;/category&gt;</inline>
   <inline>&lt;category xml:id="haiku"&gt;</inline>
    <inline>&lt;catDesc&gt;</inline>Haiku<inline>&lt;/catDesc&gt;</inline>
   <inline>&lt;/category&gt;</inline>
  <inline>&lt;/category&gt;</inline>
  <inline>&lt;category xml:id="drama"&gt;</inline>
   <inline>&lt;catDesc&gt;</inline>Drama<inline>&lt;/catDesc&gt;</inline>
  <inline>&lt;/category&gt;</inline>
 <inline>&lt;/category&gt;</inline>
 <inline>&lt;category xml:id="meter"&gt;</inline>
  <inline>&lt;catDesc&gt;</inline>Metrical Categories<inline>&lt;/catDesc&gt;</inline>
  <inline>&lt;category xml:id="feet"&gt;</inline>
   <inline>&lt;catDesc&gt;</inline>Metrical Feet<inline>&lt;/catDesc&gt;</inline>
   <inline>&lt;category xml:id="iambic"&gt;</inline>
    <inline>&lt;catDesc&gt;</inline>Iambic<inline>&lt;/catDesc&gt;</inline>
   <inline>&lt;/category&gt;</inline>
   <inline>&lt;category xml:id="trochaic"&gt;</inline>
    <inline>&lt;catDesc&gt;</inline>trochaic<inline>&lt;/catDesc&gt;</inline>
   <inline>&lt;/category&gt;</inline>
  <inline>&lt;/category&gt;</inline>
  <inline>&lt;category xml:id="feetNumber"&gt;</inline>
   <inline>&lt;catDesc&gt;</inline>Number of feet<inline>&lt;/catDesc&gt;</inline>
   <inline>&lt;category xml:id="pentameter"&gt;</inline>
    <inline>&lt;catDesc&gt;</inline>Pentameter<inline>&lt;/catDesc&gt;</inline>
   <inline>&lt;/category&gt;</inline>
   <inline>&lt;category xml:id="tetrameter"&gt;</inline>
    <inline>&lt;catDesc&gt;</inline>Tetrameter<inline>&lt;/catDesc&gt;</inline>
   <inline>&lt;/category&gt;</inline>
  <inline>&lt;/category&gt;</inline>
 <inline>&lt;/category&gt;</inline>
                           <inline>&lt;/taxonomy&gt;</inline>
                           <inline>&lt;!-- elsewhere in document --&gt;</inline>
                           <inline>&lt;lg ana="#shakesSonnet #iambic #pentameter"&gt;</inline>
 <inline>&lt;l&gt;</inline>Shall I compare thee to a summer's day<inline>&lt;/l&gt;</inline>
                           <inline>&lt;!-- ... --&gt;</inline>
                           <inline>&lt;/lg&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="1" maxOccurs="1"&gt;
  &lt;alternate minOccurs="1" maxOccurs="1"&gt;
   &lt;alternate minOccurs="1"
    maxOccurs="unbounded"&gt;
    &lt;elementRef key="category"/&gt;
    &lt;elementRef key="taxonomy"/&gt;
   &lt;/alternate&gt;
   &lt;sequence minOccurs="1" maxOccurs="1"&gt;
    &lt;alternate minOccurs="1"
     maxOccurs="unbounded"&gt;
     &lt;classRef key="model.descLike"/&gt;
    &lt;/alternate&gt;
    &lt;alternate minOccurs="0"
     maxOccurs="unbounded"&gt;
     &lt;elementRef key="category"/&gt;
     &lt;elementRef key="taxonomy"/&gt;
    &lt;/alternate&gt;
   &lt;/sequence&gt;
  &lt;/alternate&gt;
  &lt;sequence minOccurs="1" maxOccurs="1"&gt;
   &lt;classRef key="model.biblLike"/&gt;
   &lt;alternate minOccurs="0"
    maxOccurs="unbounded"&gt;
    &lt;elementRef key="category"/&gt;
    &lt;elementRef key="taxonomy"/&gt;
   &lt;/alternate&gt;
  &lt;/sequence&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schema Declaration</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element taxonomy
{
   att.global.attributes,
   (
      (
         ( category | taxonomy )+
       | ( model.descLike+, ( category | taxonomy )* )
      )
    | ( model.biblLike, ( category | taxonomy )* )
   )
}</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.teiCorpus"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.1.152. &lt;teiCorpus&gt;</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e78120">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">&lt;teiCorpus&gt; </inline>contains the whole of a TEI encoded corpus, comprising a single corpus header and one or more TEI elements, each containing a single text header and a text. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DS)">4. Default Text Structure</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html#CCDEF)">15.1. Varieties of Composite Text</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Module</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>core</block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Attributes</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>Attributes <basic-link internal-destination="TEI.att.global" text-decoration="underline">att.global</basic-link> (<inline>@xml:id</inline>, <inline>@n</inline>, <inline>@xml:lang</inline>, <inline>@xml:base</inline>, <inline>@xml:space</inline>)  (<basic-link internal-destination="TEI.att.global.rendition"
