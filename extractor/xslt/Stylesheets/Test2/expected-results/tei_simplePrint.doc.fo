                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element title
{
   att.global.attributes,
   att.canonical.attributes,
   att.typed.attribute.subtype,
   att.datable.attributes,
   attribute type { text }?,
   attribute level { "a" | "m" | "j" | "s" | "u" }?,
   macro.paraContent
}</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Processing Model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;modelSequence predicate="parent::titleStmt/parent::fileDesc"&gt;
&lt;model predicate="preceding-sibling::title"
 behaviour="text"&gt;
 &lt;param name="content" value="' — '"/&gt;
&lt;/model&gt;
&lt;model behaviour="inline"&gt;
 &lt;outputRendition&gt;color: red; font-size: 2em;&lt;/outputRendition&gt;
&lt;/model&gt;
&lt;/modelSequence&gt;
&lt;model predicate="not(@level) and parent::bibl"
 behaviour="inline"/&gt;
&lt;modelSequence predicate="@level='m' or not(@level)"&gt;
&lt;model behaviour="inline"&gt;
 &lt;outputRendition&gt;font-style: italic;&lt;/outputRendition&gt;
&lt;/model&gt;
&lt;model predicate="ancestor::biblFull"
 behaviour="text"&gt;
 &lt;param name="content" value="', '"/&gt;
&lt;/model&gt;
&lt;/modelSequence&gt;
&lt;modelSequence predicate="@level='s' or @level='j'"&gt;
&lt;model behaviour="inline"&gt;
 &lt;outputRendition&gt;font-style: italic;&lt;/outputRendition&gt;
&lt;/model&gt;
&lt;model predicate="following-sibling::* and ( ancestor::biblFull)"
 behaviour="text"&gt;
 &lt;param name="content" value="', '"/&gt;
&lt;/model&gt;
&lt;/modelSequence&gt;
&lt;modelSequence predicate="@level='u' or @level='a'"&gt;
&lt;model behaviour="inline"&gt;
 &lt;outputRendition&gt;font-style: italic;&lt;/outputRendition&gt;
&lt;/model&gt;
&lt;model predicate="following-sibling::* and ( ancestor::biblFull)"
 behaviour="text"&gt;
 &lt;param name="content" value="'. '"/&gt;
&lt;/model&gt;
&lt;/modelSequence&gt;
&lt;model behaviour="inline"&gt;
&lt;outputRendition&gt;font-style: italic;&lt;/outputRendition&gt;
&lt;/model&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
