                                    <basic-link internal-destination="TEI.argument" text-decoration="underline">argument</basic-link>
                                    <basic-link internal-destination="TEI.body" text-decoration="underline">body</basic-link>
                                    <basic-link internal-destination="TEI.div" text-decoration="underline">div</basic-link>
                                    <basic-link internal-destination="TEI.docEdition" text-decoration="underline">docEdition</basic-link>
                                    <basic-link internal-destination="TEI.epigraph" text-decoration="underline">epigraph</basic-link>
