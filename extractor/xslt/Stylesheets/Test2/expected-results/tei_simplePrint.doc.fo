                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">simple:subscript</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>subscript</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">simple:superscript</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>superscript</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">simple:topbraced</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>marked with a brace above the text</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">simple:typewriter</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>fixed-width typeface, like typewriter</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">simple:underline</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>underlined with single line</block>
                                                            </list-item-body>
                                                         </list-item>
                                                         <list-item space-before.optimum="4pt">
                                                            <list-item-label end-indent="label-end()">
                                                               <block text-align="start"
                                                                      font-weight="bold"
                                                                      keep-together.within-line="always">simple:wavyunderline</block>
                                                            </list-item-label>
                                                            <list-item-body start-indent="body-start()">
                                                               <block font-weight="normal">
                                                                  <block> </block>underlined with wavy line</block>
                                                            </list-item-body>
                                                         </list-item>
                                                      </list-block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell number-columns-spanned="2" padding="2pt" text-align="left">
                                                   <block>
                                                      <block font-family="Courier"
                                                             background-color="lightgray"
                                                             color="black"
                                                             white-space-treatment="preserve"
                                                             linefeed-treatment="preserve"
                                                             white-space-collapse="false"
                                                             wrap-option="no-wrap"
                                                             text-indent="0em"
                                                             hyphenate="false"
                                                             start-indent="12pt"
                                                             text-align="start"
                                                             font-size="6pt"
                                                             space-before.optimum="4pt"
                                                             space-after.optimum="4pt">
                                                         <inline>&lt;head rendition="#ac #sc"&gt;</inline>
 <inline>&lt;lb/&gt;</inline>To The <inline>&lt;lb/&gt;</inline>Duchesse <inline>&lt;lb/&gt;</inline>of <inline>&lt;lb/&gt;</inline>Newcastle, <inline>&lt;lb/&gt;</inline>On Her
<inline>&lt;lb/&gt;</inline>
 <inline>&lt;hi rendition="#normal"&gt;</inline>New Blazing-World<inline>&lt;/hi&gt;</inline>. 
<inline>&lt;/head&gt;</inline>
                                                         <inline>&lt;!-- elsewhere... --&gt;</inline>
                                                         <inline>&lt;rendition xml:id="sc"
 scheme="css"&gt;</inline>font-variant: small-caps<inline>&lt;/rendition&gt;</inline>
                                                         <inline>&lt;rendition xml:id="normal"
 scheme="css"&gt;</inline>font-variant: normal<inline>&lt;/rendition&gt;</inline>
                                                         <inline>&lt;rendition xml:id="ac"
 scheme="css"&gt;</inline>text-align: center<inline>&lt;/rendition&gt;</inline>
                                                      </block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                             <table-row>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <inline font-weight="bold">Note</inline>
                                                   </block>
                                                </table-cell>
                                                <table-cell padding="2pt" text-align="left">
                                                   <block>
                                                      <block line-height="1">The <inline font-style="italic">rendition</inline> attribute is used in a very similar way to the <inline font-style="italic">class</inline> attribute defined for XHTML but with the important distinction that its function is to describe the appearance of the source text, not necessarily to determine how that text should be presented on screen or paper.</block>
                                                      <block line-height="1"
                                                             text-indent="1em"
                                                             space-before.optimum="0pt"
                                                             space-before.maximum="12pt">Where both <inline font-style="italic">rendition</inline> and <inline font-style="italic">rend</inline> are supplied, the latter is understood to override or complement the former.</block>
                                                      <block line-height="1"
                                                             text-indent="1em"
                                                             space-before.optimum="0pt"
                                                             space-before.maximum="12pt">Each URI provided should indicate a <basic-link internal-destination="TEI.rendition" text-decoration="underline">&lt;rendition&gt;</basic-link> element defining the intended rendition in terms of some appropriate style language, as indicated by the <inline font-style="italic">scheme</inline> attribute.</block>
                                                   </block>
                                                </table-cell>
                                             </table-row>
                                          </table-body>
                                       </table>
                                    </block>
                                 </table-cell>
                              </table-row>
                           </table-body>
                        </table>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;s:rule context="tei:*[@rendition]"&gt;
&lt;s:let name="results"
 value="for $val in tokenize(normalize-space(@rendition),'\s+') return starts-with($val,'simple:') 
 or (starts-with($val,'#') and //tei:rendition[@xml:id=substring($val,2)])"/&gt;
&lt;s:assert test="every $x in $results satisfies $x"&gt; Error: Each of the rendition
 values in "&lt;s:value-of select="@rendition"/&gt;" must point to a local ID or to a
 token in the Simple scheme (&lt;s:value-of select="$results"/&gt;)&lt;/s:assert&gt;
&lt;/s:rule&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schematron</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;s:rule context="tei:*[@corresp]"&gt;
&lt;s:let name="results"
 value="for $t in tokenize(normalize-space(@corresp),'\s+') return starts-with($t,'#') 
 and not(id(substring($t,2)))"/&gt;
&lt;s:report test="some $x in $results satisfies $x"&gt; Error: Every local pointer in
 "&lt;s:value-of select="@corresp"/&gt;" must point to an ID in this document
 (&lt;s:value-of select="$results"/&gt;)&lt;/s:report&gt;
&lt;/s:rule&gt;</block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
         <block keep-with-next.within-page="always"
                id="TEI.att.global.responsibility"
                text-align="left"
                font-family="Times"
                font-size="12pt"
                font-weight="bold"
                font-style="italic"
                space-after="2pt"
                space-before.optimum="4pt"
                text-indent="0em">17.3.19. att.global.responsibility</block>
         <table text-align="left"
                font-size="9pt"
                table-layout="fixed"
                width="100%"
                id="d27e97432">
            <table-column column-number="1" column-width="25%"/>
            <table-column column-number="2" column-width="75%"/>
            <table-body text-indent="0pt">
               <table-row>
                  <table-cell number-columns-spanned="2"
                              border-before-style="solid"
                              border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">att.global.responsibility</inline> provides attributes indicating the agent responsible for some aspect of the text, the markup or something asserted by the markup, and the degree of certainty associated with it. [<basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STGAso)">1.3.1.1.4. Sources, certainty, and responsibility</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COED)">3.4. Simple Editorial Changes</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHHR)">11.3.2.2. Hand, Responsibility, and Certainty Attributes</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/AI.html#AISP)">17.3. Spans and Interpretations</basic-link>
                        <basic-link external-destination="url(http://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDATTSnr)">13.1.1. Linking Names and Their Referents</basic-link>]</block>
                  </table-cell>
               </table-row>
               <table-row>
