                              <basic-link internal-destination="TEI.teiHeader" text-decoration="underline">teiHeader</basic-link>
                              <basic-link internal-destination="TEI.term" text-decoration="underline">term</basic-link>
                              <basic-link internal-destination="TEI.text" text-decoration="underline">text</basic-link>
                              <basic-link internal-destination="TEI.textClass" text-decoration="underline">textClass</basic-link>
                              <basic-link internal-destination="TEI.time" text-decoration="underline">time</basic-link>
                              <basic-link internal-destination="TEI.title" text-decoration="underline">title</basic-link>
                              <basic-link internal-destination="TEI.titlePage" text-decoration="underline">titlePage</basic-link>
                              <basic-link internal-destination="TEI.titlePart" text-decoration="underline">titlePart</basic-link>
                              <basic-link internal-destination="TEI.titleStmt" text-decoration="underline">titleStmt</basic-link>
                              <basic-link internal-destination="TEI.trailer" text-decoration="underline">trailer</basic-link>
                              <basic-link internal-destination="TEI.unclear" text-decoration="underline">unclear</basic-link>
