                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">This element should be used for postal addresses only. Within it, the generic element <basic-link internal-destination="TEI.addrLine" text-decoration="underline">&lt;addrLine&gt;</basic-link> may be used as an alternative to any of the more specialized elements available from the <inline color="black" font-family="Helvetica">model.addrPart</inline> class, such as <inline hyphenate="false" color="black" font-family="Courier">&lt;street&gt;</inline>, <inline hyphenate="false" color="black" font-family="Courier">&lt;postCode&gt;</inline> etc.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
