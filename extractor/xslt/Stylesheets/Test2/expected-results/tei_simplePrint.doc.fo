                           <inline>&lt;sourceDesc&gt;</inline>
 <inline>&lt;biblFull&gt;</inline>
  <inline>&lt;titleStmt&gt;</inline>
   <inline>&lt;title&gt;</inline>Buxom Joan of Lymas's love to a jolly sailer: or, The maiden's choice:
       being love for love again. To an excellent new play-house tune.<inline>&lt;/title&gt;</inline>
   <inline>&lt;author&gt;</inline>Congreve, William, 1670-1729.<inline>&lt;/author&gt;</inline>
  <inline>&lt;/titleStmt&gt;</inline>
  <inline>&lt;extent&gt;</inline>1 sheet ([1] p.) : music. <inline>&lt;/extent&gt;</inline>
  <inline>&lt;publicationStmt&gt;</inline>
   <inline>&lt;publisher&gt;</inline>printed for P[hilip]. Brooksby, at the Golden-ball, in
       Pye-corner.,<inline>&lt;/publisher&gt;</inline>
   <inline>&lt;pubPlace&gt;</inline>London: :<inline>&lt;/pubPlace&gt;</inline>
   <inline>&lt;date&gt;</inline>[between 1693-1695]<inline>&lt;/date&gt;</inline>
  <inline>&lt;/publicationStmt&gt;</inline>
  <inline>&lt;notesStmt&gt;</inline>
   <inline>&lt;note&gt;</inline>Attributed to William Congreve by Wing.<inline>&lt;/note&gt;</inline>
   <inline>&lt;note&gt;</inline>Date of publication and publisher's name from Wing.<inline>&lt;/note&gt;</inline>
   <inline>&lt;note&gt;</inline>Verse: "A soldier and a sailer ..."<inline>&lt;/note&gt;</inline>
   <inline>&lt;note&gt;</inline>Printed in two columns.<inline>&lt;/note&gt;</inline>
   <inline>&lt;note&gt;</inline>Reproduction of original in the British Library.<inline>&lt;/note&gt;</inline>
  <inline>&lt;/notesStmt&gt;</inline>
 <inline>&lt;/biblFull&gt;</inline>
                           <inline>&lt;/sourceDesc&gt;</inline>
                        </block>
