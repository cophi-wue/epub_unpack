                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <block>
                                 <inline font-weight="bold">header: </inline>
                                 <inline>
                                    <basic-link internal-destination="TEI.creation" text-decoration="underline">creation</basic-link>
                                    <basic-link internal-destination="TEI.listChange" text-decoration="underline">listChange</basic-link>
                                    <basic-link internal-destination="TEI.revisionDesc" text-decoration="underline">revisionDesc</basic-link>
                                 </inline>
                              </block>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">May contain</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
                           <block>
                              <inline font-weight="bold">header: </inline>
                              <inline>
                                 <basic-link internal-destination="TEI.change" text-decoration="underline">change</basic-link>
                                 <basic-link internal-destination="TEI.listChange" text-decoration="underline">listChange</basic-link>
                              </inline>
                           </block>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Note</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">When this element appears within the <basic-link internal-destination="TEI.creation" text-decoration="underline">&lt;creation&gt;</basic-link> element it documents the set of revision campaigns or stages identified during the evolution of the original text. When it appears within the <basic-link internal-destination="TEI.revisionDesc" text-decoration="underline">&lt;revisionDesc&gt;</basic-link> element, it documents only changes made during the evolution of the encoded representation of that text.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;revisionDesc&gt;</inline>
 <inline>&lt;listChange&gt;</inline>
  <inline>&lt;change when="1991-11-11" who="#LB"&gt;</inline> deleted chapter 10 <inline>&lt;/change&gt;</inline>
  <inline>&lt;change when="1991-11-02" who="#MSM"&gt;</inline> completed first draft <inline>&lt;/change&gt;</inline>
 <inline>&lt;/listChange&gt;</inline>
                           <inline>&lt;/revisionDesc&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;profileDesc&gt;</inline>
 <inline>&lt;creation&gt;</inline>
  <inline>&lt;listChange ordered="true"&gt;</inline>
   <inline>&lt;change xml:id="CHG-1"&gt;</inline>First stage, written in ink by a writer<inline>&lt;/change&gt;</inline>
   <inline>&lt;change xml:id="CHG-2"&gt;</inline>Second stage, written in Goethe's hand using pencil<inline>&lt;/change&gt;</inline>
   <inline>&lt;change xml:id="CHG-3"&gt;</inline>Fixation of the revised passages and further revisions by
       Goethe using ink<inline>&lt;/change&gt;</inline>
   <inline>&lt;change xml:id="CHG-4"&gt;</inline>Addition of another stanza in a different hand,
       probably at a later stage<inline>&lt;/change&gt;</inline>
  <inline>&lt;/listChange&gt;</inline>
 <inline>&lt;/creation&gt;</inline>
                           <inline>&lt;/profileDesc&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
