                           <inline>&lt;langUsage&gt;</inline>
 <inline>&lt;language ident="fr-CA" usage="60"&gt;</inline>Québecois<inline>&lt;/language&gt;</inline>
 <inline>&lt;language ident="en-CA" usage="20"&gt;</inline>Canadian business English<inline>&lt;/language&gt;</inline>
 <inline>&lt;language ident="en-GB" usage="20"&gt;</inline>British English<inline>&lt;/language&gt;</inline>
                           <inline>&lt;/langUsage&gt;</inline>
                        </block>
