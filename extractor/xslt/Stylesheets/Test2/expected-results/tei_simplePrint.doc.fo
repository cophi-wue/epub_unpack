                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block>
&lt;s:report test="ancestor::tei:l[not(.//tei:note//tei:lg[. = current()])]"&gt; Abstract model violation: Lines may not contain line groups.
&lt;/s:report&gt;</block>
                     </block>
                  </table-cell>
