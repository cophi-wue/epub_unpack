                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block line-height="1">Contains an optional heading and a series of rows.</block>
                        <block line-height="1"
                               text-indent="1em"
                               space-before.optimum="0pt"
                               space-before.maximum="12pt">Any rendition information should be supplied using the global <inline font-style="italic">rend</inline> attribute, at the table, row, or cell level as appropriate.</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Example</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
                           <inline>&lt;table rows="4" cols="4"&gt;</inline>
 <inline>&lt;head&gt;</inline>Poor Men's Lodgings in Norfolk (Mayhew, 1843)<inline>&lt;/head&gt;</inline>
 <inline>&lt;row role="label"&gt;</inline>
  <inline>&lt;cell role="data"/&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>Dossing Cribs or Lodging Houses<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>Beds<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>Needys or Nightly Lodgers<inline>&lt;/cell&gt;</inline>
 <inline>&lt;/row&gt;</inline>
 <inline>&lt;row role="data"&gt;</inline>
  <inline>&lt;cell role="label"&gt;</inline>Bury St Edmund's<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>5<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>8<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>128<inline>&lt;/cell&gt;</inline>
 <inline>&lt;/row&gt;</inline>
 <inline>&lt;row role="data"&gt;</inline>
  <inline>&lt;cell role="label"&gt;</inline>Thetford<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>3<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>6<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>36<inline>&lt;/cell&gt;</inline>
 <inline>&lt;/row&gt;</inline>
 <inline>&lt;row role="data"&gt;</inline>
  <inline>&lt;cell role="label"&gt;</inline>Attleboro'<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>3<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>5<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>20<inline>&lt;/cell&gt;</inline>
 <inline>&lt;/row&gt;</inline>
 <inline>&lt;row role="data"&gt;</inline>
  <inline>&lt;cell role="label"&gt;</inline>Wymondham<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>1<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>11<inline>&lt;/cell&gt;</inline>
  <inline>&lt;cell role="data"&gt;</inline>22<inline>&lt;/cell&gt;</inline>
 <inline>&lt;/row&gt;</inline>
                           <inline>&lt;/table&gt;</inline>
                        </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Content model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence minOccurs="1" maxOccurs="1"&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.headLike"/&gt;
   &lt;classRef key="model.global"/&gt;
  &lt;/alternate&gt;
  &lt;alternate minOccurs="1" maxOccurs="1"&gt;
   &lt;sequence minOccurs="1"
    maxOccurs="unbounded"&gt;
    &lt;elementRef key="row"/&gt;
    &lt;classRef key="model.global"
     minOccurs="0" maxOccurs="unbounded"/&gt;
   &lt;/sequence&gt;
   &lt;sequence minOccurs="1"
    maxOccurs="unbounded"&gt;
    &lt;classRef key="model.graphicLike"/&gt;
    &lt;classRef key="model.global"
     minOccurs="0" maxOccurs="unbounded"/&gt;
   &lt;/sequence&gt;
  &lt;/alternate&gt;
  &lt;sequence minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.divBottom"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Schema Declaration</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
element table
{
   att.global.attributes,
   att.typed.attributes,
   attribute rows { text }?,
   attribute cols { text }?,
   (
      ( model.headLike | model.global )*,
      ( ( row, model.global* )+ | ( model.graphicLike, model.global* )+ ),
      ( model.divBottom, model.global* )*
   )
}</block>
                     </block>
                  </table-cell>
               </table-row>
               <table-row>
                  <table-cell border-after-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <inline font-weight="bold">Processing Model</inline>
                     </block>
                  </table-cell>
                  <table-cell border-after-style="solid"
                              border-end-style="solid"
                              border-start-style="solid"
                              padding="2pt"
                              text-align="left">
                     <block>
                        <block font-family="Courier"
                               background-color="lightgray"
                               color="black"
                               white-space-treatment="preserve"
                               linefeed-treatment="preserve"
                               white-space-collapse="false"
                               wrap-option="no-wrap"
                               text-indent="0em"
                               hyphenate="false"
                               start-indent="12pt"
                               text-align="start"
                               font-size="6pt"
                               space-before.optimum="4pt"
                               space-after.optimum="4pt">
&lt;model behaviour="table"&gt;
&lt;outputRendition&gt; font-size: smaller; background-color: #F0F0F0; &lt;/outputRendition&gt;
&lt;/model&gt;
    </block>
                     </block>
                  </table-cell>
               </table-row>
            </table-body>
         </table>
